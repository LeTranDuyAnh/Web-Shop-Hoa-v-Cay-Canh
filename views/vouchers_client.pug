doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title VNUA FloraHub - Kho Ưu Đãi
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
    link(href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Quicksand:wght@300;400;500;600;700&display=swap", rel="stylesheet")
    style.
      :root {
        --pink-main: #FF85A1;
        --pink-dark: #E91E63;
        --pink-soft: #FBB1BD;
        --pink-bg: #FFF0F3;
        --text-dark: #4A4A4A;
        --white: #FFFFFF;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Quicksand', sans-serif; background: var(--pink-bg); color: var(--text-dark); overflow-x: hidden; }
      
      /* --- NAVBAR --- */
      .navbar { 
        display: flex; justify-content: space-between; align-items: center; 
        padding: 12px 5%; background: rgba(255, 255, 255, 0.98); 
        position: sticky; top: 0; z-index: 1000; box-shadow: 0 2px 15px rgba(0,0,0,0.05); 
      }
      .logo { font-family: 'Dancing Script', cursive; font-size: 2.2rem; color: var(--pink-main); text-decoration: none; }
      .nav-menu { display: flex; list-style: none; gap: 15px; align-items: center; }
      .nav-link { 
        text-decoration: none; color: var(--text-dark); font-weight: 700; 
        font-size: 0.9rem; padding: 8px 20px; transition: 0.3s; border-radius: 50px;
      }
      .nav-link.active { background: var(--pink-main); color: white; box-shadow: 0 4px 10px rgba(255, 133, 161, 0.3); }
      .nav-link:not(.active):hover { color: var(--pink-main); }
      .nav-right { display: flex; align-items: center; gap: 15px; }
      .icon-btn { color: var(--pink-main); font-size: 1.2rem; text-decoration: none; position: relative; transition: 0.3s; }
      .cart-count { 
        background: #ff4757; color: white; border-radius: 50%; padding: 2px 6px; 
        font-size: 0.65rem; position: absolute; top: -8px; right: -8px; border: 2px solid white; 
      }
      .btn-exit { background: #4A4A4A; color: white; padding: 8px 18px; border-radius: 50px; text-decoration: none; font-weight: 700; font-size: 0.8rem; }

      /* --- BANNER SLIDER --- */
      .hero-slider { position: relative; height: 60vh; min-height: 400px; width: 100%; overflow: hidden; }
      .slide { 
        position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; 
        transition: opacity 1s ease-in-out; display: flex; align-items: center; padding: 0 10%; 
        background-size: cover; background-position: center; z-index: 1;
      }
      .slide.active { opacity: 1; z-index: 2; }
      .hero-content { position: relative; z-index: 10; max-width: 500px; }
      .hero-content h1 { font-family: 'Dancing Script', cursive; font-size: 4rem; color: var(--pink-main); margin-bottom: 15px; text-shadow: 2px 2px 4px rgba(255,255,255,0.8); }

      /* *** ĐIỀU CHỈNH KÍCH THƯỚC NÚT KHÁM PHÁ CHO NHỎ LẠI *** */
      .btn-hero { 
        padding: 8px 20px; /* Giảm padding */
        font-size: 0.9rem; /* Giảm font-size */
        border-radius: 50px; 
        background: var(--pink-main); 
        color: white; 
        font-weight: 700; 
        text-decoration: none; 
        display: inline-block; 
        transition: 0.3s;
        box-shadow: 0 4px 15px rgba(255, 133, 161, 0.4); 
        border: none; 
        cursor: pointer; 
      }
      .btn-hero:hover { background: var(--pink-dark); }
      
      /* Riêng nút trong voucher section thì full width */
      #vouchers-section .btn-hero { width: 100%; }

      /* --- VOUCHER CARD --- */
      .voucher-card { 
        background: var(--white); border-radius: 25px; padding: 0; overflow: hidden;
        transition: 0.4s; border: 1px solid #fef0f2; display: flex; flex-direction: column;
        box-shadow: 0 5px 15px rgba(0,0,0,0.02);
      }
      .voucher-card:hover { transform: translateY(-10px); box-shadow: 0 12px 25px rgba(255, 133, 161, 0.15); }
      
      .v-top {
        background: linear-gradient(45deg, var(--pink-main), var(--pink-soft));
        padding: 30px 20px; color: white; text-align: center; position: relative;
      }
      .v-top i { font-size: 2.5rem; margin-bottom: 10px; opacity: 0.9; }
      .v-top h3 { font-size: 2rem; font-weight: 800; margin: 0; }
      
      .v-bottom { padding: 20px; text-align: center; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between; }
      .v-code { 
        background: #fdf2f4; border: 2px dashed var(--pink-main); color: var(--pink-dark);
        padding: 10px; border-radius: 12px; font-family: monospace; font-size: 1.2rem;
        font-weight: 800; margin-bottom: 15px; letter-spacing: 1px;
      }

      /* --- NÚT CHAT --- */
      .social-chat-wrapper { position: fixed; bottom: 30px; right: 30px; display: flex; flex-direction: column; gap: 15px; z-index: 9999; }
      .chat-btn { width: 55px; height: 55px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none; color: white; font-size: 28px; box-shadow: 0 6px 20px rgba(0,0,0,0.15); transition: 0.4s; animation: bounce 2.5s infinite; }
      .chat-btn.zalo { background: #0084FF; padding: 8px; }
      .chat-btn.messenger { background: linear-gradient(45deg, #006AFF, #00E5FF); }
      @keyframes bounce { 0%, 20%, 50%, 80%, 100% { transform: translateY(0); } 40% { transform: translateY(-12px); } 60% { transform: translateY(-6px); } }

  body
    header
      nav.navbar
        a.logo(href="/") FloraHub
        ul.nav-menu
          li: a.nav-link(href="/") Trang chủ
          li: a.nav-link(href="/explore") Shop Hoa
          li: a.nav-link(href="/wiki") Cẩm nang
          li: a.nav-link.active(href="/vouchers") Kho Vouchers
          li: a.nav-link(href="/blog") Tin tức
        .nav-right
          a.icon-btn(href="/cart")
            i.fas.fa-shopping-basket
            if typeof cartCount !== 'undefined' && cartCount > 0
              span.cart-count= cartCount
          if session && session.user
            a.icon-btn(href="/profile"): i.fas.fa-user-circle
            a.btn-exit(href="/logout") Thoát
          else
            a.nav-link(href="/login" style="padding: 8px 15px") Đăng nhập

    section.hero-slider
      .slide(style="background-image: linear-gradient(to right, rgba(255,240,243,0.8), rgba(255,240,243,0.2)), url('https://images.unsplash.com/photo-1526047932273-341f2a7631f9?w=1600');")
        .hero-content
          h1 Bloom with Love
          p Những bó hoa thiết kế thủ công tinh tế dành riêng cho bạn.
          br
          a.btn-hero(href="/explore") Ghé Thăm Shop Ngay
      .slide(style="background-image: linear-gradient(to right, rgba(255,240,243,0.8), rgba(255,240,243,0.2)), url('https://images.unsplash.com/photo-1490750967868-88aa4486c946?auto=format&fit=crop&q=80&w=1600');")
          .hero-content
            h1 Sweet Moments
            p Trao gửi chân tình qua từng sắc hoa rực rỡ và dịu dàng.
            br
            a.btn-hero(href="/explore") Khám phá cửa hàng

      .slide(style="background-image: linear-gradient(to right, rgba(255,240,243,0.8), rgba(255,240,243,0.2)), url('https://images.unsplash.com/photo-1464851707681-f9d5fdaccea8?auto=format&fit=crop&q=80&w=1600');")
          .hero-content
            h1 Plant Library
            a.btn-hero(href="/wiki") Khám phá cẩm nang
    //- PHẦN HIỂN THỊ TẤT CẢ VOUCHER (THAY THẾ PHẦN PRODUCTS)
    section#vouchers-section(style="padding: 80px 8%; background: white;")
      h2(style="text-align: center; font-size: 2.5rem; margin-bottom: 10px; font-weight: 800; color: var(--pink-dark); font-family: 'Dancing Script', cursive;") Kho Voucher Của Bạn
      p(style="text-align: center; color: #888; margin-bottom: 50px; font-weight: 500;") Chọn ngay ưu đãi tốt nhất cho đơn hàng của mình

      .grid-container(style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 30px;")
        if vouchers && vouchers.length > 0
          each v in vouchers
            .voucher-card
              .v-top
                i.fas.fa-ticket-alt
                h3= v.discountType === 'percent' ? v.discountValue + '%' : (v.discountValue/1000) + 'K'
                p(style="font-size: 0.9rem; font-weight: 600; text-transform: uppercase;") Giảm giá
              .v-bottom
                div
                  p(style="font-weight: 700; color: #444; margin-bottom: 5px;")= `Cho đơn từ ${v.minOrderValue.toLocaleString('vi-VN')}đ`
                  p(style="font-size: 0.85rem; color: #999; margin-bottom: 15px;")= `HSD: ${new Date(v.expiryDate).toLocaleDateString('vi-VN')}`
                .v-code= v.code
                button.btn-hero(onclick=`copyVoucher('${v.code}')`) SAO CHÉP MÃ
        else
          div(style="grid-column: 1/-1; text-align: center; padding: 50px;")
            p(style="color: #bbb; font-style: italic;") Hiện tại chưa có mã giảm giá nào mới.

    footer(style="background: var(--white); padding: 80px 8% 40px; border-top: 5px solid var(--pink-bg);")
      div(style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 40px;")
        div
          a.logo(href="/") FloraHub
          p(style="margin-top: 20px; line-height: 1.8; color: #888; font-size: 0.9rem;") VNUA FloraHub mang đến những đóa hoa tươi thắm nhất, thay bạn gửi gắm yêu thương đến những người trân quý.
        
        div
          h4(style="margin-bottom: 20px; font-weight: 800; color: #333;") Dịch Vụ
          ul(style="list-style: none; line-height: 2;")
            li: a(href="/" style="text-decoration: none; color: #777;") Trang chủ
            li: a(href="/explore" style="text-decoration: none; color: #777;") Shop hoa
            li: a(href="/wiki" style="text-decoration: none; color: #777;") Cẩm nang
            li: a(href="/vouchers" style="text-decoration: none; color: #777;") Kho vouchers
            li: a(href="/blog" style="text-decoration: none; color: #777;") Tin tức
            li: a(href="/my-orders" style="text-decoration: none; color: #777;") Lịch sử đặt hàng
            li: a(href="/track-order" style="text-decoration: none; color: #777;") Theo dõi đơn
        
        div
          h4(style="margin-bottom: 20px; font-weight: 800; color: #333;") Liên Hệ
          ul(style="list-style: none; color: #777; font-size: 0.9rem; line-height: 2;")
            li <i class="fas fa-map-marker-alt" style="color: var(--pink-main); margin-right: 10px;"></i> Trâu Quỳ, Gia Lâm, Hà Nội
            li <i class="fas fa-phone-alt" style="color: var(--pink-main); margin-right: 10px;"></i> 0123 456 789
      
      div(style="text-align: center; margin-top: 60px; padding-top: 20px; border-top: 1px solid #f2f2f2; color: #bbb; font-size: 0.8rem;")
        p &copy; 2026 VNUA FloraHub. Thiết kế bởi FloraHub Team.

    


    .social-chat-wrapper
      a.chat-btn.zalo(href="https://zalo.me/0398102869" target="_blank"): img(src="https://upload.wikimedia.org/wikipedia/commons/9/91/Icon_Zalo.svg")
      a.chat-btn.messenger(href="#" target="_blank"): i.fab.fa-facebook-messenger


    script.
      // Slider logic đơn giản
      document.addEventListener('DOMContentLoaded', () => {
        const slides = document.querySelectorAll('.slide');
        if(slides.length > 0) {
          slides[0].classList.add('active');
          let current = 0;
          setInterval(() => {
            slides[current].classList.remove('active');
            current = (current + 1) % slides.length;
            slides[current].classList.add('active');
          }, 4000);
        }
      });

      function copyVoucher(code) {
        navigator.clipboard.writeText(code);
        alert('Đã sao chép mã: ' + code);
      }