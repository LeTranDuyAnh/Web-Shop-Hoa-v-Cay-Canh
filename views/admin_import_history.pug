doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Quản lý nhập kho - FloraAdmin
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
    link(href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600;700;800&display=swap", rel="stylesheet")
    style.
      :root {
        --pink-main: #E91E63; 
        --pink-dark: #C2185B; 
        --pink-bg: #F8BBD0; 
        --text-dark: #2d3436; 
        --white: #FFFFFF;
      }
      
      * { box-sizing: border-box; }
      body { font-family: 'Quicksand', sans-serif; background-color: #fdf2f4; margin: 0; color: var(--text-dark); }
      
      .admin-layout { display: flex; min-height: 100vh; width: 100%; }

      /* --- SIDEBAR ĐỒNG BỘ 280PX --- */
      nav.admin-sidebar {
        width: 280px; min-width: 280px; background: var(--white);
        border-right: 2px solid var(--pink-bg); padding: 30px 20px;
        height: 100vh; position: sticky; top: 0;
      }
      .logo { font-size: 1.8rem; font-weight: 800; color: var(--pink-dark); margin-bottom: 40px; text-align: center; }
      .logo span { color: var(--pink-main); font-weight: 400; }
      
      .admin-sidebar ul { list-style: none; padding: 0; margin: 0; }
      .admin-sidebar li { margin-bottom: 8px; }
      .admin-sidebar a { 
        display: flex; align-items: center; gap: 12px; padding: 14px 20px; 
        text-decoration: none; color: #888; border-radius: 15px; font-weight: 600; transition: 0.3s;
      }
      .admin-sidebar li.active a { background: var(--pink-main); color: white; box-shadow: 0 4px 15px rgba(233, 30, 99, 0.2); }
      .admin-sidebar a:hover:not(.active) { background: #fce4ec; color: var(--pink-main); }

      .badge-pending {
        background: var(--pink-dark); color: white; padding: 2px 8px; border-radius: 12px;
        font-size: 0.7rem; margin-left: auto; font-weight: bold;
        animation: blink-animation 1.5s linear infinite;
      }
      @keyframes blink-animation {
        0% { transform: scale(1); }
        50% { transform: scale(1.1); }
        100% { transform: scale(1); }
      }

      /* --- MAIN CONTENT --- */
      .admin-main { flex-grow: 1; padding: 40px; background-color: #fce4ec; }
      .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
      
      .btn-add { 
        background: var(--pink-dark); color: white; border: none; padding: 12px 25px; 
        border-radius: 50px; cursor: pointer; font-weight: 700; transition: 0.3s;
        box-shadow: 0 5px 15px rgba(194, 24, 91, 0.4); display: flex; align-items: center; gap: 8px;
        height: 48px; justify-content: center; text-decoration: none;
      }
      .btn-add:hover { background: var(--pink-main); transform: translateY(-2px); }

      /* --- STYLE CHI THEO NGÀY --- */
      .day-group-header {
        display: flex; justify-content: space-between; align-items: center;
        background: #fce4ec; padding: 12px 25px; border-radius: 15px;
        margin-top: 25px; margin-bottom: 5px; border-left: 5px solid var(--pink-main);
      }
      .day-title { font-weight: 800; color: var(--pink-dark); font-size: 1rem; margin: 0; }
      .day-total { font-weight: 700; color: var(--text-dark); font-size: 0.95rem; }
      .day-total span { color: var(--pink-main); font-weight: 800; }

      /* Table Style - Card Mode */
      .admin-table { width: 100%; border-collapse: separate; border-spacing: 0 10px; margin-bottom: 15px; }
      .admin-table th { padding: 10px 15px; text-align: left; color: #bbb; text-transform: uppercase; font-size: 11px; letter-spacing: 1px; }
      .admin-table td { padding: 15px; background: white; transition: 0.3s; vertical-align: middle; }
      .admin-table td:first-child { border-radius: 20px 0 0 20px; }
      .admin-table td:last-child { border-radius: 0 20px 20px 0; }

      .qty-badge { background: #fce4ec; color: var(--pink-dark); padding: 6px 12px; border-radius: 10px; font-weight: 800; }
      .flower-thumb { width: 45px; height: 45px; object-fit: cover; border-radius: 12px; border: 2px solid var(--pink-bg); margin-right: 12px; }

      /* Form nhóm trong Modal */
      .form-group { display: flex; flex-direction: column; gap: 8px; margin-bottom: 15px; }
      .form-group label { font-weight: 700; font-size: 13px; color: #555; }
      .form-group input, .form-group select, .form-group textarea { 
        width: 100%; padding: 14px; border: 2px solid #f0f0f0; 
        border-radius: 15px; outline: none; font-family: inherit; transition: 0.3s; background: #fafafa;
      }
      .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--pink-main); background: white; }

      /* Modal PopUp Đồng Bộ */
      .modal { display: none; position: fixed; z-index: 2000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; backdrop-filter: blur(4px); }
      .modal-content { background: white; padding: 35px; border-radius: 30px; width: 500px; position: relative; border: 2px solid var(--pink-bg); }
      .close-modal { position: absolute; right: 25px; top: 20px; font-size: 1.5rem; cursor: pointer; color: #ccc; }
      .close-modal:hover { color: var(--pink-main); }

  body
    .admin-layout
      //- Thanh Sidebar đồng bộ
      nav.admin-sidebar
        .logo Flora<span>Admin</span>
        ul
          li: a(href="/admin") <i class="fas fa-spa"></i> Quản lý hoa
          li: a(href="/admin/library") <i class="fas fa-book-medical"></i> Cẩm nang cây cảnh
          li: a(href="/admin/users") <i class="fas fa-user-shield"></i> Đội ngũ quản trị
          li: a(href="/admin/orders") 
            i.fas.fa-heart
            | Đơn hàng mới
            if pendingCount > 0
              span.badge-pending #{pendingCount}
          li: a(href="/admin/analytics") <i class="fas fa-chart-pie"></i> Doanh thu shop
          li: a(href="/admin/blog/create") <i class="fas fa-pen-nib"></i> Viết bài Blog
          li: a(href="/admin/vouchers") <i class="fas fa-ticket-alt"></i> Quản lý Voucher
          li.active: a(href="/admin/import-history") 
            i.fas.fa-boxes
            | Quản lý nhập kho
          li: a(href="/") <i class="fas fa-external-link-alt"></i> Xem cửa hàng
          li: a(href="/logout" style="color: #ff7675;margin-top: 50px;") <i class="fas fa-power-off"></i> Đăng xuất

      //- Nội dung chính vùng Admin
      main.admin-main
        header.admin-header
          h2(style="margin:0; font-weight: 800; color: #444;") 
            i.fas.fa-history(style="color: var(--pink-main); margin-right: 12px;") 
            | Nhật ký nhập kho dữ liệu
          
          button.btn-add(type="button" onclick="openImportModal()")
            i.fas.fa-plus-circle
            | Lập phiếu nhập kho

        //- ----------------================-----------------
        //- LOGIC JAVASCRIPT GOM NHÓM THEO NGÀY VÀ TÍNH TỔNG CHI
        //- ----------------================-----------------
        if history && history.length > 0
          - var groups = {}
          each item in history
            - var dateKey = new Date(item.import_date).toLocaleDateString('vi-VN')
            if !groups[dateKey]
              - groups[dateKey] = { items: [], totalCost: 0 }
            - groups[dateKey].items.push(item)
            - groups[dateKey].totalCost += (item.quantity * item.import_price)
          
          //- Duyệt qua từng ngày đã gom nhóm để hiển thị
          each groupData, dateString in groups
            .day-group-header
              h3.day-title
                i.far.fa-calendar-alt.me-2
                | Ngày nhập kho: #{dateString}
              div.day-total Tổng chi trong ngày: 
                span #{groupData.totalCost.toLocaleString('vi-VN')} đ

            table.admin-table
              thead
                tr
                  th(style="width: 15%;") Giờ nhập
                  th(style="width: 30%;") Tên sản phẩm
                  th(style="width: 15%;") Số lượng
                  th(style="width: 15%;") Giá nhập gốc
                  th(style="width: 15%;") Thành tiền
                  th(style="width: 10%;") Ghi chú
              tbody
                each item in groupData.items
                  tr
                    td: span.fw-semibold(style="color: #666; font-size: 14px;")= new Date(item.import_date).toLocaleTimeString('vi-VN', {hour: '2-digit', minute:'2-digit'})
                    td
                      if item.flower_info
                        div(style="display: flex; align-items: center;")
                          if item.flower_info.image
                            img.flower-thumb(src=item.flower_info.image)
                          strong(style="color: var(--text-dark);")= item.flower_info.name
                      else
                        span(style="color: #ff7675; text-decoration: line-through;") (Sản phẩm đã bị xóa)
                    td: span.qty-badge= '+' + item.quantity + ' chậu'
                    td(style="font-weight: 600; color: #666;")= item.import_price.toLocaleString('vi-VN') + ' đ'
                    td: strong(style="color: var(--pink-dark); font-size: 1.05rem;")= (item.quantity * item.import_price).toLocaleString('vi-VN') + ' đ'
                    td
                      if item.note
                        span(style="color: #888; font-size: 13px; font-style: italic;" title=item.note) Chi tiết
                      else
                        span(style="color: #ccc;") ---
        else
          table.admin-table
            tbody
              tr: td(colspan="6", style="text-align:center; padding: 50px; color: #bbb;") Hệ thống chưa ghi nhận đợt nhập kho nào.

    //- ==========================================
    //- MODAL POPUP: FORM TẠO PHIẾU NHẬP KHO
    //- ==========================================
    #importModal.modal
      .modal-content
        span.close-modal(onclick="closeImportModal()") &times;
        h3(style="color: var(--pink-dark); margin-top:0; font-weight:800;") 
          i.fas.fa-boxes(style="margin-right: 10px;")
          | Nhập hàng vào kho
        
        form(action="/admin/import-stock" method="POST" style="margin-top:20px;")
          div(style="display:grid; gap:5px;")
            .form-group
              label Chọn loài hoa nhập:
              select(name="productId" required)
                option(value="" disabled selected) -- Chọn sản phẩm từ vườn VNUA --
                if flowers
                  each flower in flowers
                    option(value=flower._id) #{flower.name} (Tồn: #{flower.stock || 0} chậu)
            
            div(style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;")
              .form-group
                label Số lượng chậu:
                input(type="number" name="quantity" min="1" placeholder="Ví dụ: 50" required)
              
              .form-group
                label Giá gốc (đ/chậu):
                input(type="number" name="importPrice" min="0" placeholder="Ví dụ: 45000" required)
            
            .form-group
              label Ghi chú nội bộ:
              textarea(name="note" rows="3" placeholder="Nhập nhà vườn cung cấp hoặc tình trạng hoa...")
            
            button.btn-add(type="submit" style="width: 100%; margin-top: 10px;") 
              i.fas.fa-check-circle
              | Xác nhận hoàn tất nhập kho

    //- Điều khiển bật/tắt Modal bằng Javascript thuần giống trang Voucher
    script.
      function openImportModal() {
        document.getElementById('importModal').style.display = 'flex';
      }

      function closeImportModal() {
        document.getElementById('importModal').style.display = 'none';
      }
      
      window.onclick = function(event) {
        const modal = document.getElementById('importModal');
        if (event.target == modal) {
          closeImportModal();
        }
      }