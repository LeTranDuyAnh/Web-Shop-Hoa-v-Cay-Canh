    //- --- BANNER VOUCHER 10% ---
    //- --- PHẦN ƯU ĐÃI THÀNH VIÊN MỚI (CHÀO MỪNG + VOUCHER) ---
    section.voucher-banner-container
      style.
        /* Container chính */
        .voucher-banner-container {
          padding: 100px 8%;
          background: #fff;
          display: flex;
          flex-direction: column;
          align-items: center;
        }

        /* 1. CSS CHO DÒNG CHÀO MỪNG */
        .welcome-text-container {
          text-align: center;
          margin-bottom: 50px;
        }
        .welcome-badge {
          background: #fff0f3; /* Màu hồng rất nhạt */
          color: var(--pink-dark);
          padding: 10px 25px;
          border-radius: 50px;
          font-size: 0.85rem;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 2px;
          display: inline-block;
          margin-bottom: 15px;
          box-shadow: 0 5px 15px rgba(255, 133, 161, 0.1);
        }
        .welcome-main-title {
          font-family: 'Dancing Script', cursive;
          font-size: 3.5rem;
          color: var(--pink-dark);
          margin: 0;
          line-height: 1.2;
        }
        .welcome-main-title span {
          color: var(--pink-main);
        }
        .welcome-sub-title {
          color: #888;
          font-size: 1.1rem;
          font-weight: 500;
          margin-top: 10px;
        }

        /* 2. CSS CHO TẤM VÉ VOUCHER */
        .voucher-ticket {
          display: flex;
          width: 100%;
          max-width: 950px;
          background: white;
          border-radius: 35px;
          position: relative;
          filter: drop-shadow(0 20px 45px rgba(255, 133, 161, 0.25));
          border: 1px solid #fff0f3;
          overflow: visible;
        }

        .ticket-left {
          flex: 1.8;
          padding: 60px;
          background: radial-gradient(circle at top left, #ffffff, #fffcfd);
          border-radius: 35px 0 0 35px;
          position: relative;
        }

        .ticket-left h2 {
          font-family: 'Dancing Script', cursive;
          font-size: 3rem;
          color: var(--pink-dark);
          margin-bottom: 5px;
        }

        .discount-val {
          font-family: 'Quicksand', sans-serif;
          font-size: 4.8rem;
          font-weight: 800;
          color: var(--pink-main);
          line-height: 1;
          margin: 15px 0;
          text-shadow: 2px 2px 0px rgba(255, 133, 161, 0.1);
        }

        .ticket-left p {
          font-size: 1.15rem;
          color: #666;
          max-width: 90%;
          line-height: 1.6;
        }

        .ticket-right {
          flex: 1;
          background: linear-gradient(135deg, var(--pink-main), var(--pink-dark));
          color: white;
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          padding: 40px;
          text-align: center;
          border-radius: 0 35px 35px 0;
          position: relative;
        }

        /* Hiệu ứng đục lỗ đặc trưng của vé */
        .punch-hole {
          position: absolute;
          width: 40px;
          height: 40px;
          background: #fff; /* Trùng với nền ngoài để tạo hiệu ứng khuyết */
          border-radius: 50%;
          left: -20px;
          z-index: 10;
        }
        .punch-top { top: -20px; }
        .punch-bottom { bottom: -20px; }

        .ticket-divider {
          position: absolute;
          left: -1px;
          top: 15%;
          height: 70%;
          border-left: 2px dashed rgba(255, 255, 255, 0.3);
        }

        .promo-code {
          background: rgba(255, 255, 255, 0.95);
          color: var(--pink-dark);
          padding: 18px 30px;
          border-radius: 18px;
          font-size: 1.6rem;
          font-weight: 800;
          margin-bottom: 15px;
          cursor: pointer;
          transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
          box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
          letter-spacing: 2px;
        }

        .promo-code:hover {
          transform: scale(1.1) rotate(-3deg);
          background: #fff;
          box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
        }

        .btn-voucher-action {
          background: white;
          color: var(--pink-dark);
          padding: 12px 35px;
          border-radius: 50px;
          text-decoration: none;
          font-weight: 800;
          font-size: 0.9rem;
          margin-top: 15px;
          transition: 0.3s;
          box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .btn-voucher-action:hover {
          transform: translateY(-3px);
          box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

        /* Mobile */
        @media (max-width: 768px) {
          .welcome-main-title { font-size: 2.5rem; }
          .voucher-ticket { flex-direction: column; }
          .ticket-left { border-radius: 35px 35px 0 0; padding: 40px; text-align: center; }
          .ticket-left p { max-width: 100%; }
          .discount-val { font-size: 3.5rem; }
          .ticket-right { border-radius: 0 0 35px 35px; padding: 50px 30px; }
          .punch-hole, .ticket-divider { display: none; }
        }

      //- 1. PHẦN CHỮ CHÀO MỪNG
      .welcome-text-container
        .welcome-badge Ưu đãi đặc biệt
        h2.welcome-main-title Quà Tặng <span>Thành Viên Mới</span>
        p.welcome-sub-title Cùng FloraHub lan tỏa yêu thương qua những đóa hoa tươi thắm

      //- 2. PHẦN VOUCHER
      .voucher-ticket
        .ticket-left
          .punch-hole.punch-top
          .punch-hole.punch-bottom
          h2 Sweet Welcome!
          .discount-val GIẢM 10%
          p Chúc mừng bạn đã gia nhập gia đình FloraHub. Nhận ngay ưu đãi cho đơn hàng đầu tiên của bạn!
          small(style="color: #ccc; margin-top: 25px; display: block; font-style: italic;") * Áp dụng cho đơn hàng bất kì.
        
        .ticket-right
          .ticket-divider
          p(style="margin-bottom: 15px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; font-size: 0.8rem; opacity: 0.9;") Copy mã tại đây:
          .promo-code(onclick="copyVoucher('NEW2026')") NEW2026
          p(style="font-size: 0.75rem; opacity: 0.85;") (Nhấn vào mã để sao chép nhanh)
          
          if !session || !session.user
            a.btn-voucher-action(href="/login") Đăng nhập ngay
          else
            a.btn-voucher-action(href="/explore") Mua sắm ngay

    //- JavaScript xử lý copy
    script.
      function copyVoucher(code) {
        navigator.clipboard.writeText(code).then(() => {
          alert('🌿 Tuyệt vời! Bạn đã copy mã: ' + code + '. Hãy chọn cho mình những bông hoa thật xinh nhé!');
