doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title VNUA FloraHub - Trao Gửi Yêu Thương
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
    link(href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Quicksand:wght@300;400;500;600;700&display=swap", rel="stylesheet")
    style.
      :root {
        --pink-main: #FF85A1;
        --pink-dark: #E91E63;
        --pink-soft: #FBB1BD;
        --pink-bg: #FFF0F3;
        --text-dark: #4A4A4A;
        --white: #FFFFFF;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Quicksand', sans-serif; background: var(--pink-bg); color: var(--text-dark); overflow-x: hidden; }
      
      /* --- NAVBAR --- */
      .navbar { 
        display: flex; justify-content: space-between; align-items: center; 
        padding: 12px 5%; background: rgba(255, 255, 255, 0.98); 
        position: sticky; top: 0; z-index: 1000; box-shadow: 0 2px 15px rgba(0,0,0,0.05); 
      }
      .logo { font-family: 'Dancing Script', cursive; font-size: 2.2rem; color: var(--pink-main); text-decoration: none; }
      
      .nav-menu { display: flex; list-style: none; gap: 15px; align-items: center; }
      .nav-link { 
        text-decoration: none; color: var(--text-dark); font-weight: 700; 
        font-size: 0.9rem; padding: 8px 20px; transition: 0.3s; border-radius: 50px;
      }
      .nav-link.active { background: var(--pink-main); color: white; box-shadow: 0 4px 10px rgba(255, 133, 161, 0.3); }
      .nav-link:not(.active):hover { color: var(--pink-main); }

      .nav-right { display: flex; align-items: center; gap: 15px; }
      .icon-btn { color: var(--pink-main); font-size: 1.2rem; text-decoration: none; position: relative; transition: 0.3s; }
      .cart-count { 
        background: #ff4757; color: white; border-radius: 50%; padding: 2px 6px; 
        font-size: 0.65rem; position: absolute; top: -8px; right: -8px; border: 2px solid white; 
      }
      .btn-exit { background: #4A4A4A; color: white; padding: 8px 18px; border-radius: 50px; text-decoration: none; font-weight: 700; font-size: 0.8rem; }

      /* --- BANNER --- */
      .hero-slider { position: relative; height: 70vh; min-height: 450px; width: 100%; overflow: hidden; background: #fce4ec; }
      .slide { 
        position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; 
        transition: opacity 1s ease-in-out; display: flex; align-items: center; padding: 0 10%; 
        background-size: cover; background-position: center; z-index: 1;
      }
      .slide.active { opacity: 1; z-index: 2; }
      .hero-content { position: relative; z-index: 10; max-width: 500px; }
      .hero-content h1 { font-family: 'Dancing Script', cursive; font-size: 4rem; color: var(--pink-main); margin-bottom: 15px; text-shadow: 2px 2px 4px rgba(255,255,255,0.8); }
      
      .btn-hero { 
        padding: 12px 35px; border-radius: 50px; background: var(--pink-main); color: white; 
        font-weight: 700; text-decoration: none; display: inline-block; transition: 0.3s;
        box-shadow: 0 4px 15px rgba(255, 133, 161, 0.4);
      }
      .btn-hero:hover { transform: translateY(-3px); background: var(--pink-dark); }

      /* --- CATEGORY GRID --- */
      .category-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 20px;
      }
      .category-item {
        text-decoration: none; text-align: center; padding: 25px 10px; 
        border-radius: 30px; background: var(--pink-bg); transition: 0.3s;
        display: flex; flex-direction: column; align-items: center;
      }
      .category-item:hover { transform: translateY(-5px); background: #ffe4e9; box-shadow: 0 10px 20px rgba(255, 133, 161, 0.1); }
      .category-item i { font-size: 2rem; color: var(--pink-main); margin-bottom: 12px; }
      .category-item h4 { color: var(--text-dark); font-size: 0.95rem; font-weight: 700; }

      /* --- PRODUCT CARD --- */
      .product-card { background: var(--white); border-radius: 30px; padding: 20px; text-align: center; transition: 0.4s; border: 1px solid #fef0f2; }
      .product-card:hover { transform: translateY(-10px); box-shadow: 0 12px 25px rgba(255, 133, 161, 0.15); }
      .product-card img { width: 100%; height: 260px; object-fit: cover; border-radius: 25px; margin-bottom: 15px; }

      section { padding: 60px 8%; }
      .view-all-container { text-align: center; margin-top: 40px; }
      .btn-view-all { 
        padding: 14px 45px; border: 2px solid var(--pink-main); color: var(--pink-main); 
        text-decoration: none; border-radius: 50px; font-weight: 700; transition: 0.3s;
      }
      .btn-view-all:hover { background: var(--pink-main); color: white; }

      /* --- NÚT CHAT BONG BÓNG --- */
      .social-chat-wrapper {
        position: fixed;
        bottom: 30px;
        right: 30px;
        display: flex;
        flex-direction: column;
        gap: 15px;
        z-index: 9999;
      }
      .chat-btn {
        width: 55px;
        height: 55px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: white;
        font-size: 28px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.15);
        transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        animation: bounce 2.5s infinite;
      }
      .chat-btn.zalo { background: #0084FF; padding: 8px; }
      .chat-btn.messenger { background: linear-gradient(45deg, #006AFF, #00E5FF); }
      .chat-btn:hover { transform: scale(1.1) translateY(-5px); box-shadow: 0 10px 25px rgba(0,0,0,0.25); }
      .chat-btn img { width: 100%; height: 100%; object-fit: contain; }

      @keyframes bounce {
        0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
        40% { transform: translateY(-12px); }
        60% { transform: translateY(-6px); }
      }

      @media (max-width: 992px) {
        .category-grid { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
        .social-chat-wrapper { bottom: 20px; right: 20px; }
      }

    script.
      document.addEventListener('DOMContentLoaded', () => {
        const slides = document.querySelectorAll('.slide');
        let current = 0;
        if(slides.length > 0) {
          slides[0].classList.add('active');
          setInterval(() => {
            slides[current].classList.remove('active');
            current = (current + 1) % slides.length;
            slides[current].classList.add('active');
          }, 4000); 
        }
      });

  body
    header
      nav.navbar
        a.logo(href="/") FloraHub
        
        ul.nav-menu
          li: a.nav-link.active(href="/") Trang chủ
          li: a.nav-link(href="/explore") Shop Hoa
          li: a.nav-link(href="/wiki") Cẩm nang
          li: a.nav-link(href="/blog") Tin tức
        
        .nav-right
          a.icon-btn(href="/cart")
            i.fas.fa-shopping-basket
            if (typeof cartCount !== 'undefined' && cartCount > 0)
              span.cart-count= cartCount
          
          if session && session.user
            if session.user.role === 'admin'
              a.icon-btn(href="/admin" title="Quản trị"): i.fas.fa-user-shield
            a.icon-btn(href="/profile" title="Tài khoản"): i.fas.fa-user-circle
            a.btn-exit(href="/logout") Thoát
          else
            a.nav-link(href="/login" style="padding: 8px 15px") Đăng nhập

    section.hero-slider
      .slide(style="background-image: linear-gradient(to right, rgba(255,240,243,0.8), rgba(255,240,243,0.2)), url('https://images.unsplash.com/photo-1526047932273-341f2a7631f9?auto=format&fit=crop&q=80&w=1600');")
        .hero-content
          h1 Bloom with Love
          p Những bó hoa thiết kế thủ công tinh tế nhất dành cho phái đẹp.
          br
          a.btn-hero(href="/explore") Ghé Thăm Shop Ngay
      
      .slide(style="background-image: linear-gradient(to right, rgba(255,240,243,0.8), rgba(255,240,243,0.2)), url('https://images.unsplash.com/photo-1490750967868-88aa4486c946?auto=format&fit=crop&q=80&w=1600');")
        .hero-content
          h1 Sweet Moments
          p Trao gửi chân tình qua từng sắc hoa rực rỡ và dịu dàng.
          br
          a.btn-hero(href="/explore") Khám phá cửa hàng

      .slide(style="background-image: linear-gradient(to right, rgba(255,240,243,0.8), rgba(255,240,243,0.2)), url('https://images.unsplash.com/photo-1464851707681-f9d5fdaccea8?auto=format&fit=crop&q=80&w=1600');")
        .hero-content
          h1 Plant Library
          a.btn-hero(href="/wiki") Khám phá cẩm nang

    section(style="background: white; border-radius: 60px 60px 0 0; position: relative; z-index: 10; margin-top: -40px;")
      .category-grid
        - 
          const categories = [
            {n: 'Hoa Cảnh', i: 'fa-leaf', c: 'Hoa cảnh'}, 
            {n: 'Cây Cảnh', i: 'fa-seedling', c: 'Cây cảnh'}, 
            {n: 'Hoa Cưới', i: 'fa-ring', c: 'Hoa cưới'}, 
            {n: 'Sinh Nhật', i: 'fa-cake-candles', c: 'Hoa sinh nhật'}, 
            {n: 'Sự Kiện', i: 'fa-microphone-lines', c: 'Hoa sự kiện'}
          ]
        each cat in categories
          a.category-item(href=`/explore?category=${encodeURIComponent(cat.c)}`)
            i.fas(class=cat.i)
            h4= cat.n

    section#products
      h2(style="text-align: center; font-size: 2.2rem; margin-bottom: 40px; font-weight: 800; color: #333;") Sản phẩm nổi bật
      .grid-container(style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 30px;")
        if (typeof flowers !== 'undefined' && flowers && flowers.length > 0)
          each flower in flowers
            .product-card
              img(src=(flower.image || 'https://via.placeholder.com/300x400?text=FloraHub'))
              h3(style="margin-bottom: 10px;")= flower.name
              p(style="color: var(--pink-main); font-weight: 800; font-size: 1.3rem; margin-bottom: 15px;")= (flower.price ? flower.price.toLocaleString('vi-VN') + ' đ' : 'Liên hệ')
              div(style="display: flex; gap: 10px; justify-content: center;")
                a.btn-hero(href=`/flower/${flower._id}` style="background: #f8f9fa; color: #777; box-shadow: none; padding: 10px 20px;") Chi tiết
                form(action="/cart/add", method="POST")
                  input(type="hidden", name="flowerId", value=flower._id.toString())
                  button.btn-hero(type="submit" style="padding: 10px 20px;") <i class="fas fa-cart-plus"></i>
        else
          p(style="text-align: center; grid-column: 1/-1; color: #999;") Đang cập nhật hoa mới...

      if (typeof flowers !== 'undefined' && flowers.length >= 8)
        .view-all-container
          a.btn-view-all(href="/explore") 
            span Xem tất cả hoa đang bán
            i.fas.fa-arrow-right(style="margin-left: 10px;")

    footer(style="background: var(--white); padding: 80px 8% 40px; border-top: 5px solid var(--pink-bg);")
      div(style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 40px;")
        div
          a.logo(href="/") FloraHub
          p(style="margin-top: 20px; line-height: 1.8; color: #888; font-size: 0.9rem;") VNUA FloraHub mang đến những đóa hoa tươi thắm nhất, thay bạn gửi gắm yêu thương đến những người trân quý.
        
        div
          h4(style="margin-bottom: 20px; font-weight: 800; color: #333;") Dịch Vụ
          ul(style="list-style: none; line-height: 2;")
            li: a(href="/explore" style="text-decoration: none; color: #777;") Trang chủ
            li: a(href="/explore" style="text-decoration: none; color: #777;") Shop hoa
            li: a(href="/explore" style="text-decoration: none; color: #777;") Cẩm nang
            li: a(href="/blog" style="text-decoration: none; color: #777;") Tin tức
            li: a(href="/my-orders" style="text-decoration: none; color: #777;") Lịch sử đặt hàng
            li: a(href="/track-order" style="text-decoration: none; color: #777;") Theo dõi đơn
        
        div
          h4(style="margin-bottom: 20px; font-weight: 800; color: #333;") Liên Hệ
          ul(style="list-style: none; color: #777; font-size: 0.9rem; line-height: 2;")
            li <i class="fas fa-map-marker-alt" style="color: var(--pink-main); margin-right: 10px;"></i> Trâu Quỳ, Gia Lâm, Hà Nội
            li <i class="fas fa-phone-alt" style="color: var(--pink-main); margin-right: 10px;"></i> 0123 456 789
      
      div(style="text-align: center; margin-top: 60px; padding-top: 20px; border-top: 1px solid #f2f2f2; color: #bbb; font-size: 0.8rem;")
        p &copy; 2026 VNUA FloraHub. Thiết kế bởi FloraHub Team.

    //- NÚT CHAT BONG BÓNG (ZALO & MESSENGER)
    .social-chat-wrapper
      //- Nút Zalo (Thay 0123456789 bằng số thật của bạn)
