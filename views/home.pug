    //- --- THANH TÌM KIẾM THEO TỪ KHÓA ---
    section.search-section-container
      style.
        .search-section-container {
          padding: 40px 8% 20px 8%;
          background: #fff;
          display: flex;
          justify-content: center;
        }

        .search-wrapper {
          width: 100%;
          max-width: 700px;
          position: relative;
          display: flex;
          align-items: center;
          background: #fff;
          border: 2px solid #fff0f3;
          padding: 8px 8px 8px 25px;
          border-radius: 50px;
          transition: all 0.3s ease;
          box-shadow: 0 10px 25px rgba(255, 133, 161, 0.1);
        }

        .search-wrapper:focus-within {
          border-color: var(--pink-main);
          box-shadow: 0 15px 30px rgba(255, 133, 161, 0.2);
          transform: translateY(-2px);
        }

        .search-input {
          flex: 1;
          border: none;
          outline: none;
          font-family: 'Quicksand', sans-serif;
          font-size: 1.1rem;
          font-weight: 600;
          color: #555;
          background: transparent;
        }

        .search-input::placeholder {
          color: #bbb;
          font-weight: 500;
        }

        .btn-search {
          background: linear-gradient(135deg, var(--pink-main), var(--pink-dark));
          color: white;
          border: none;
          padding: 12px 30px;
          border-radius: 50px;
          font-family: 'Quicksand', sans-serif;
          font-weight: 700;
          cursor: pointer;
          display: flex;
          align-items: center;
          gap: 8px;
          transition: 0.3s;
        }

        .btn-search:hover {
          transform: scale(1.05);
          box-shadow: 0 5px 15px rgba(255, 133, 161, 0.3);
          opacity: 0.9;
        }

        .search-icon-inside {
          color: var(--pink-main);
          margin-right: 15px;
          font-size: 1.2rem;
        }

        /* Gợi ý từ khóa phổ biến bên dưới thanh search */
        .popular-tags {
          margin-top: 15px;
          font-size: 0.9rem;
          color: #888;
          text-align: center;
        }
        .tag-link {
          color: var(--pink-main);
          text-decoration: none;
          margin: 0 8px;
          font-weight: 600;
          transition: 0.2s;
        }
        .tag-link:hover {
          text-decoration: underline;
          color: var(--pink-dark);
        }

        @media (max-width: 576px) {
          .search-wrapper { padding: 5px 5px 5px 15px; }
          .btn-search { padding: 10px 20px; span { display: none; } } /* Ẩn chữ 'Tìm kiếm' trên mobile chỉ hiện icon */
        }

      .search-box-area(style="width: 100%; max-width: 700px;")
        form(action="/explore" method="GET")
          .search-wrapper
            i.fas.fa-search.search-icon-inside
            input.search-input(type="text" name="keyword" placeholder="Bạn đang tìm loại hoa nào?...")
            button.btn-search(type="submit")
              i.fas.fa-paper-plane
              span Tìm kiếm      
    section#products(style="padding: 60px 8%; background: white;")
      h2(style="text-align: center; font-size: 2.2rem; margin-bottom: 40px; font-weight: 800;") Sản phẩm nổi bật
      .grid-container(style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 30px;")
        if flowers && flowers.length > 0
          each flower in flowers
            .product-card
              img(src=(flower.image || 'https://via.placeholder.com/300x400'))
              h3= flower.name
