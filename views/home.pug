      style.
        .voucher-banner-container {
          padding: 60px 8%;
          background: #fffafb;
          display: flex;
          justify-content: center;
          align-items: center;
        }
        .voucher-ticket {
          display: flex;
          width: 100%;
          max-width: 850px;
          background: linear-gradient(135deg, #FFF0F3 0%, #FBB1BD 100%);
          border-radius: 24px;
          box-shadow: 0 10px 30px rgba(255, 133, 161, 0.15);
          position: relative;
          overflow: hidden;
          border: 1px solid rgba(255, 133, 161, 0.2);
        }
        /* Tạo vết lõm răng cưa kiểu thỏi vé ở 2 đầu */
        .voucher-ticket::before, .voucher-ticket::after {
          content: '';
          position: absolute;
          top: 50%;
          width: 24px;
          height: 24px;
          background: #fff; /* Trùng với màu nền ngoài container */
          border-radius: 50%;
          transform: translateY(-50%);
          z-index: 5;
        }
        .voucher-ticket::before { left: -12px; box-shadow: inset -3px 0 5px rgba(0,0,0,0.03); }
        .voucher-ticket::after { right: -12px; box-shadow: inset 3px 0 5px rgba(0,0,0,0.03); }

        /* Vế trái: Nội dung chương trình */
        .ticket-left {
          flex: 2;
          padding: 40px;
          display: flex;
          flex-direction: column;
          justify-content: center;
        }
        .ticket-left h2 {
          font-family: 'Quicksand', sans-serif;
          font-size: 1.8rem;
          font-weight: 800;
          color: #4A4A4A;
          margin-bottom: 8px;
        }
        .ticket-left p {
          font-size: 0.95rem;
          color: #666;
          font-weight: 500;
          margin-bottom: 15px;
        }
        .discount-val {
          font-family: 'Dancing Script', cursive;
          font-size: 2.5rem;
          font-weight: 700;
          color: var(--pink-dark);
          line-height: 1;
        }

        /* Đường ranh giới đứt nét giữa 2 vế */
        .ticket-divider {
          width: 2px;
          border-left: 2px dashed rgba(255, 133, 161, 0.5);
          position: relative;
          margin: 20px 0;
        }

        /* Vế phải: Nơi chứa Code và tương tác */
        .ticket-right {
          flex: 1;
          padding: 40px;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          background: rgba(255, 255, 255, 0.4);
          backdrop-filter: blur(5px);
          text-align: center;
        }
        .promo-code {
          background: var(--white);
          color: var(--pink-dark);
          font-weight: 800;
          font-size: 1.3rem;
          letter-spacing: 1px;
          padding: 10px 24px;
          border-radius: 12px;
          border: 2px dashed var(--pink-main);
          box-shadow: 0 4px 10px rgba(255, 133, 161, 0.1);
          margin-bottom: 10px;
          cursor: pointer;
          transition: all 0.3s ease;
        }
        .promo-code:hover {
          transform: scale(1.05);
          background: var(--pink-main);
          color: white;
          border-color: transparent;
        }
        .ticket-right p {
          font-size: 0.8rem;
          font-weight: 700;
          color: #888;
          text-transform: uppercase;
          letter-spacing: 0.5px;
        }

        /* Responsive cho điện thoại */
        @media (max-width: 650px) {
          .voucher-ticket { flex-direction: column; }
          .ticket-divider { width: auto; height: 2px; border-left: none; border-top: 2px dashed rgba(255, 133, 161, 0.5); margin: 0 20px; }
          .ticket-left, .ticket-right { padding: 30px 20px; text-align: center; }
          .ticket-right { background: rgba(255, 255, 255, 0.2); }
          .voucher-ticket::before, .voucher-ticket::after { display: none; } /* Ẩn lõm tròn khi xoay dọc */
        }
      
