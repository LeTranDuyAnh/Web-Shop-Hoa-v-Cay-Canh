doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title VNUA FloraHub - Trao Gửi Yêu Thương
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
    link(href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Quicksand:wght@300;400;500;600;700;800&display=swap", rel="stylesheet")
    style.
      :root {
        --pink-main: #FF85A1;
        --pink-dark: #E91E63;
        --pink-soft: #FBB1BD;
        --pink-bg: #FFF0F3;
        --text-dark: #4A4A4A;
        --white: #FFFFFF;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Quicksand', sans-serif; background: var(--pink-bg); color: var(--text-dark); overflow-x: hidden; }
      
      /* --- NAVBAR --- */
      .navbar { 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        padding: 12px 5%; 
        background: rgba(255, 255, 255, 0.98); 
        
        /* CỐ ĐỊNH NAVBAR */
        position: fixed; 
        top: 0; 
        left: 0; 
        width: 100%; 
        z-index: 9999; /* Đảm bảo nó luôn nằm trên cùng */
        
        box-shadow: 0 2px 15px rgba(0,0,0,0.05); 
        transition: all 0.3s ease;
      }

      /* Hiệu ứng khi cuộn xuống (được thêm bởi JS) */
      .navbar.scrolled {
        padding: 8px 5%; /* Thu nhỏ thanh menu */
        background: rgba(255, 255, 255, 0.98);
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        backdrop-filter: blur(10px); /* Làm mờ phần nội dung bên dưới */
        border-bottom: 1px solid rgba(255, 133, 161, 0.1);
      }

      .logo { font-family: 'Dancing Script', cursive; font-size: 2.2rem; color: var(--pink-main); text-decoration: none; }
      .nav-menu { display: flex; list-style: none; gap: 15px; align-items: center; }
      .nav-link { 
        text-decoration: none; color: var(--text-dark); font-weight: 700; 
        font-size: 0.9rem; padding: 8px 20px; transition: 0.3s; border-radius: 50px;
      }
      .nav-link.active { background: var(--pink-main); color: white; box-shadow: 0 4px 10px rgba(255, 133, 161, 0.3); }
      .nav-link:not(.active):hover { color: var(--pink-main); }
      .nav-right { display: flex; align-items: center; gap: 15px; }
      .icon-btn { color: var(--pink-main); font-size: 1.2rem; text-decoration: none; position: relative; transition: 0.3s; }
      .cart-count { 
        background: #ff4757; color: white; border-radius: 50%; padding: 2px 6px; 
        font-size: 0.65rem; position: absolute; top: -8px; right: -8px; border: 2px solid white; 
      }
      .btn-exit { background: #4A4A4A; color: white; padding: 8px 18px; border-radius: 50px; text-decoration: none; font-weight: 700; font-size: 0.8rem; }
      /* --- BANNER SLIDER --- */
      .hero-slider { position: relative; height: 70vh; min-height: 450px; width: 100%; overflow: hidden; background: #fce4ec; }
      .slide { 
        position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; 
        transition: opacity 1s ease-in-out; display: flex; align-items: center; padding: 0 10%; 
        background-size: cover; background-position: center; z-index: 1;
      }

      .slide.active { opacity: 1; z-index: 2; }
      .hero-content { position: relative; z-index: 10; max-width: 500px; }
      .hero-content h1 { font-family: 'Dancing Script', cursive; font-size: 4rem; color: var(--pink-main); margin-bottom: 15px; text-shadow: 2px 2px 4px rgba(255,255,255,0.8); }
      .btn-hero { 
        padding: 12px 35px; border-radius: 50px; background: var(--pink-main); color: white; 
        font-weight: 700; text-decoration: none; display: inline-block; transition: 0.3s;
        box-shadow: 0 4px 15px rgba(255, 133, 161, 0.4);
      }
      .btn-hero:hover { transform: translateY(-3px); background: var(--pink-dark); }

      /* --- CẤU TRÚC GIAO DIỆN ZÍC-ZẮC MỚI --- */
      .zigzag-container { width: 100%; display: flex; flex-direction: column; }
      .zigzag-section { padding: 80px 8%; display: flex; gap: 50px; align-items: center; min-height: 480px; box-sizing: border-box; }
      .zigzag-section:nth-child(odd) { background: #ffffff; }
      .zigzag-section:nth-child(even) { flex-direction: row-reverse; background: #fffafb; }
      
      /* Cột Banner giới thiệu bên cạnh */
      .section-banner { flex: 1; max-width: 360px; text-align: left; }
      .zigzag-section:nth-child(even) .section-banner { text-align: right; }
      .section-banner i { font-size: 3.2rem; margin-bottom: 15px; display: inline-block; }
      .section-banner h2 { font-size: 2.3rem; font-weight: 800; line-height: 1.2; margin: 10px 0 15px 0; color: var(--text-dark); }
      .section-banner p { color: #666; font-size: 0.95rem; line-height: 1.6; margin: 0; }
      
      /* Lưới chứa sản phẩm */
      .section-content { flex: 2.5; }
      .prod-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 25px; }
      
      /* Thẻ sản phẩm cải tiến */
      .p-card { background: white; border-radius: 25px; padding: 18px; text-align: center; border: 1px solid rgba(0,0,0,0.03); transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.4s; position: relative; box-sizing: border-box; }
      .p-card:hover { transform: translateY(-8px); box-shadow: 0 15px 30px rgba(255, 133, 161, 0.12); }
      .p-img { width: 100%; height: 250px; object-fit: cover; border-radius: 18px; margin-bottom: 15px; }
      .p-name { font-size: 1.1rem; margin: 0 0 8px 0; font-weight: 700; color: #333; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .p-price { font-weight: 800; font-size: 1.15rem; margin: 0 0 15px 0; }
      .p-badge { position: absolute; top: 15px; left: 15px; background: #636e72; color: white; padding: 4px 12px; border-radius: 50px; font-size: 0.7rem; font-weight: 800; z-index: 5; letter-spacing: 0.5px; }
      
      /* Cấu trúc nút hành động gọn gàng */
      .btn-actions { display: flex; gap: 8px; justify-content: center; align-items: center; }
      .btn-hero-action { padding: 10px 18px; border-radius: 50px; border: none; font-weight: 700; font-size: 0.85rem; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; transition: 0.2s ease; box-sizing: border-box; }
      .btn-hero-action:active { transform: scale(0.95); }
      
      /* Trạng thái danh mục trống */
      .empty-state { grid-column: 1/-1; text-align: center; padding: 40px; color: #bbb; font-size: 0.95rem; }
      .empty-state i { font-size: 2.5rem; margin-bottom: 10px; opacity: 0.6; }
      
      /* Hiệu ứng Reveal cuộn mượt mà */
      .reveal { opacity: 0; transform: translateY(50px); transition: opacity 0.8s ease, transform 0.8s ease; }
      .reveal.active { opacity: 1; transform: translateY(0); }
      .stagger-item { opacity: 0; transform: scale(0.92) translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
      .stagger-item.active { opacity: 1; transform: scale(1) translateY(0); }

      /* Tương thích di động (Responsive) */
      @media (max-width: 992px) {
        .zigzag-section, .zigzag-section:nth-child(even) { flex-direction: column !important; text-align: center !important; gap: 30px; padding: 50px 5%; }
        .section-banner { max-width: 100%; }
      }

      /* --- NÚT CHAT --- */
      .social-chat-wrapper { position: fixed; bottom: 30px; right: 30px; display: flex; flex-direction: column; gap: 15px; z-index: 9999; }
      .chat-btn { width: 55px; height: 55px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none; color: white; font-size: 28px; box-shadow: 0 6px 20px rgba(0,0,0,0.15); transition: 0.4s; animation: bounce 2.5s infinite; }
      .chat-btn.zalo { background: #0084FF; padding: 8px; }
      .chat-btn.messenger { background: linear-gradient(45deg, #006AFF, #00E5FF); }
      @keyframes bounce { 0%, 20%, 50%, 80%, 100% { transform: translateY(0); } 40% { transform: translateY(-12px); } 60% { transform: translateY(-6px); } }

  body
    header
      nav.navbar
        a.logo(href="/") FloraHub
        ul.nav-menu
          li: a.nav-link.active(href="/") Trang chủ
          li: a.nav-link(href="/explore") Shop Hoa
          li: a.nav-link(href="/wiki") Cẩm nang
          li: a.nav-link(href="/vouchers") Kho Vouchers
          li: a.nav-link(href="/blog") Tin tức
        .nav-right
          a.icon-btn(href="/cart")
            i.fas.fa-shopping-basket
            if typeof cartCount !== 'undefined' && cartCount > 0
              span.cart-count= cartCount
        
          if session && session.user
            if session.user.role === 'admin'
              a.icon-btn(href="/admin" title="Quản trị"): i.fas.fa-user-shield
            a.icon-btn(href="/profile" title="Tài khoản"): i.fas.fa-user-circle
            a.btn-exit(href="/logout") Thoát
          else
            a.nav-link(href="/login" style="padding: 8px 15px") Đăng nhập

    section.hero-slider
      .slide(style="background-image: linear-gradient(to right, rgba(255,240,243,0.8), rgba(255,240,243,0.2)), url('https://images.unsplash.com/photo-1526047932273-341f2a7631f9?w=1600');")
        .hero-content
          h1 Bloom with Love
          p Những bó hoa thiết kế thủ công tinh tế dành riêng cho bạn.
          br
          a.btn-hero(href="/explore") Ghé Thăm Shop Ngay
      .slide(style="background-image: linear-gradient(to right, rgba(255,240,243,0.8), rgba(255,240,243,0.2)), url('https://images.unsplash.com/photo-1490750967868-88aa4486c946?auto=format&fit=crop&q=80&w=1600');")
          .hero-content
            h1 Sweet Moments
            p Trao gửi chân tình qua từng sắc hoa rực rỡ và dịu dàng.
            br
            a.btn-hero(href="/explore") Khám phá cửa hàng
      .slide(style="background-image: linear-gradient(to right, rgba(255,240,243,0.8), rgba(255,240,243,0.2)), url('https://images.unsplash.com/photo-1464851707681-f9d5fdaccea8?auto=format&fit=crop&q=80&w=1600');")
          .hero-content
            h1 Plant Library
            a.btn-hero(href="/wiki") Khám phá cẩm nang

    //- --- THANH TÌM KIẾM THEO TỪ KHÓA ---
    section.search-section-container
      style.
        .search-section-container { padding: 40px 8% 20px 8%; background: #fff; display: flex; justify-content: center; }
        .search-wrapper { width: 100%; max-width: 700px; position: relative; display: flex; align-items: center; background: #fff; border: 2px solid #fff0f3; padding: 8px 8px 8px 25px; border-radius: 50px; transition: all 0.3s ease; box-shadow: 0 10px 25px rgba(255, 133, 161, 0.1); }
        .search-wrapper:focus-within { border-color: var(--pink-main); box-shadow: 0 15px 30px rgba(255, 133, 161, 0.2); transform: translateY(-2px); }
        .search-input { flex: 1; border: none; outline: none; font-family: 'Quicksand', sans-serif; font-size: 1.1rem; font-weight: 600; color: #555; background: transparent; }
        .search-input::placeholder { color: #bbb; font-weight: 500; }
        .btn-search { background: linear-gradient(135deg, var(--pink-main), var(--pink-dark)); color: white; border: none; padding: 12px 30px; border-radius: 50px; font-family: 'Quicksand', sans-serif; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 8px; transition: 0.3s; }
        .btn-search:hover { transform: scale(1.05); box-shadow: 0 5px 15px rgba(255, 133, 161, 0.3); opacity: 0.9; }
        .search-icon-inside { color: var(--pink-main); margin-right: 15px; font-size: 1.2rem; }
        @media (max-width: 576px) { .search-wrapper { padding: 5px 5px 5px 15px; } .btn-search { padding: 10px 20px; span { display: none; } } }
      .search-box-area(style="width: 100%; max-width: 700px;")
        form(action="/explore" method="GET")
          .search-wrapper
            i.fas.fa-search.search-icon-inside
            input.search-input(type="text" name="keyword" placeholder="Bạn đang tìm loại hoa nào?...")
            button.btn-search(type="submit")
              i.fas.fa-paper-plane
              span Tìm kiếm      

    //- ==========================================
    //- KHU VỰC CONTAINER CHỨA CÁC DANH MỤC ZÍC-ZẮC
    //- ==========================================
    .zigzag-container

      //- 1. PHẦN SẢN PHẨM NỔI BẬT (Odd - Banner Trái)
      section.zigzag-section
        .section-banner.reveal
          i.fas.fa-star(style="color: #f1c40f;")
          h2 Sản Phẩm Nổi Bật
          p(style="color: var(--pink-main); font-weight: 700; margin-bottom: 10px;") Bộ sưu tập đặc sắc nhất tại FloraHub
          p Tuyển chọn những mẫu sản phẩm cao cấp, tinh tế, nhận được nhiều sự yêu thích nhất từ khách hàng trong thời gian qua.
        .section-content
          if flowers && flowers.length > 0
            style.
              /* Khung chứa các slide */
              .slider-wrapper {
                overflow: hidden;
                width: 100%;
                position: relative;
              }
              .slider-track {
                display: flex;
                transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
                width: 100%;
              }
              /* Mỗi slide sẽ chứa tối đa 3 sản phẩm */
              .slider-page {
                min-width: 100%;
                max-width: 100%;
              }
              /* Container bọc các nút tròn xinh */
              .slider-dots {
                display: flex;
                justify-content: center;
                gap: 10px;
                margin-top: 30px;
              }
              .dot {
                width: 12px;
                height: 12px;
                border-radius: 50%;
                background: #e0e0e0;
                cursor: pointer;
                border: none;
                padding: 0;
                transition: all 0.3s ease;
              }
              .dot.active {
                background: var(--pink-main);
                width: 28px; /* Hiệu ứng kéo dài nút đang chọn nhìn rất hiện đại */
                border-radius: 6px;
              }

            .slider-wrapper
              .slider-track#featured-track
                //- Chia danh sách thành các trang, mỗi trang chứa 3 sản phẩm
                - for (var i = 0; i < flowers.length; i += 3)
                  .slider-page
                    .prod-grid
                      each flower in flowers.slice(i, i + 3)
                        .p-card.stagger-item
                          img.p-img(src=(flower.image || 'https://via.placeholder.com/300x400'))
                          h3.p-name= flower.name
                          p.p-price(style="color: var(--pink-main);")= (flower.price ? flower.price.toLocaleString('vi-VN') + ' đ' : 'Liên hệ')
                          .btn-actions
                            a.btn-hero-action(href=`/flower/${flower._id}` style="background: #f8f9fa; color: #777;") Chi tiết
                            form(action="/cart/add", method="POST")
                              input(type="hidden", name="flowerId", value=flower._id.toString())
                              button.btn-hero-action(type="submit" style="background: var(--pink-main); color: white;") #[i.fas.fa-cart-plus]
            
            //- Các nút chấm tròn điều khiển (Render tự động dựa trên số trang)
            .slider-dots
              - var pageCount = Math.ceil(flowers.length / 3)
              - for (var j = 0; j < pageCount; j++)
                button.dot(class=(j === 0 ? 'active' : '') onclick=`moveSlider(this, ${j})`)

            //- Đoạn Script xử lý hiệu ứng chạy slide
            script.
              function moveSlider(dotElement, pageIndex) {
                // Tìm đến phần track của slider này
                const track = document.getElementById('featured-track');
                if (!track) return;
                
                // Di chuyển slider track theo tỉ lệ phần trăm
                track.style.transform = `translateX(-${pageIndex * 100}%)`;
                
                // Cập nhật lại trạng thái active cho các nút tròn của slider này
                const dotsContainer = dotElement.parentElement;
                dotsContainer.querySelectorAll('.dot').forEach(dot => dot.classList.remove('active'));
                dotElement.classList.add('active');
              }
          else
            .empty-state
              i.fas.fa-store-slash
              p Hiện đang cập nhật các sản phẩm nổi bật...

      //- 2. CÂY BONSAI NGHỆ THUẬT (Even - Banner Phải)
      section.zigzag-section
        .section-banner.reveal
          i.fas.fa-leaf(style="color: #2ecc71;")
          h2 Cây Bonsai Nghệ Thuật
          p Những tác phẩm nghệ thuật sống động, được tạo tác tỉ mỉ từ đôi bàn tay nghệ nhân, mang lại vượng khí và nét thanh tịnh cho không gian sống.
        .section-content
          .prod-grid
            if ornamentalPlants && ornamentalPlants.length > 0
              each plant in ornamentalPlants.slice(0, 3)
                - var isOut = (plant.stock <= 0)
                .p-card.stagger-item(style=`border-color: #e8f8f0; ${isOut ? 'filter: grayscale(0.8); opacity: 0.7;' : ''}`)
                  if isOut
                    span.p-badge HẾT HÀNG
                  img.p-img(src=(plant.image || 'https://via.placeholder.com/300x400'))
                  h3.p-name= plant.name
                  p.p-price(style="color: #2ecc71;")= (plant.price ? plant.price.toLocaleString('vi-VN') + ' đ' : 'Liên hệ')
                  .btn-actions
                    a.btn-hero-action(href=`/flower/${plant._id}` style="background: #f8f9fa; color: #777;") Chi tiết
                    if !isOut
                      form(action="/cart/add", method="POST")
                        input(type="hidden", name="flowerId", value=plant._id.toString())
                        button.btn-hero-action(type="submit" style="background: #2ecc71; color: white;") #[i.fas.fa-cart-plus]
                    else
                      button.btn-hero-action(disabled style="background: #ccc; color: white; cursor: not-allowed;") #[i.fas.fa-ban]
            else
              .empty-state
                i.fas.fa-seedling
                p Hiện đang cập nhật các mẫu Bonsai mới...

      //- 3. HOA ĐÁM CƯỚI LUNG LINH (Odd - Banner Trái)
      section.zigzag-section
        .section-banner.reveal
          i.fas.fa-heart(style="color: #d63384;")
          h2 Hoa Đám Cưới Lung Linh
          p Tôn vinh ngày hạnh phúc lứa đôi trọn vẹn với các thiết kế hoa cưới cầm tay, hoa trang trí không gian tiệc cưới lãng mạn, ngọt ngào tuyệt đối.
        .section-content
          .prod-grid
            if weddingFlowers && weddingFlowers.length > 0
              each flower in weddingFlowers.slice(0, 3)
                - var isOut = (flower.stock <= 0)
                .p-card.stagger-item(style=`border-color: #fce4ec; ${isOut ? 'filter: grayscale(0.8); opacity: 0.7;' : ''}`)
                  if isOut
                    span.p-badge HẾT HÀNG
                  img.p-img(src=(flower.image || 'https://via.placeholder.com/300x400'))
                  h3.p-name= flower.name
                  p.p-price(style="color: #d63384;")= (flower.price ? flower.price.toLocaleString('vi-VN') + ' đ' : 'Liên hệ')
                  .btn-actions
                    a.btn-hero-action(href=`/flower/${flower._id}` style="background: #f8f9fa; color: #777;") Chi tiết
                    if !isOut
                      form(action="/cart/add", method="POST")
                        input(type="hidden", name="flowerId", value=flower._id.toString())
                        button.btn-hero-action(type="submit" style="background: #d63384; color: white;") #[i.fas.fa-cart-plus]
                    else
                      button.btn-hero-action(disabled style="background: #ccc; color: white; cursor: not-allowed;") #[i.fas.fa-ban]
            else
              .empty-state
                i.fas.fa-heart-broken
                p Đang cập nhật các mẫu hoa cưới mới nhất...

      //- 4. HOA SINH NHẬT TƯƠI THẮM (Even - Banner Phải)
      section.zigzag-section
        .section-banner.reveal
          i.fas.fa-birthday-cake(style="color: #ff9f43;")
          h2 Hoa Sinh Nhật Tươi Thắm
          p Gửi trao lời chúc mừng tuổi mới ngập tràn niềm vui, may mắn và thịnh vượng đến người thân, bạn bè qua những tone màu tươi sáng rực rỡ.
        .section-content
          .prod-grid
            if birthdayFlowers && birthdayFlowers.length > 0
              each flower in birthdayFlowers.slice(0, 3)
                - var isOut = (flower.stock <= 0)
                .p-card.stagger-item(style=`border-color: #fff5e6; ${isOut ? 'filter: grayscale(0.8); opacity: 0.7;' : ''}`)
                  if isOut
                    span.p-badge HẾT HÀNG
                  img.p-img(src=(flower.image || 'https://via.placeholder.com/300x400'))
                  h3.p-name= flower.name
                  p.p-price(style="color: #ff9f43;")= (flower.price ? flower.price.toLocaleString('vi-VN') + ' đ' : 'Liên hệ')
                  .btn-actions
                    a.btn-hero-action(href=`/flower/${flower._id}` style="background: #f8f9fa; color: #777;") Chi tiết
                    if !isOut
                      form(action="/cart/add", method="POST")
                        input(type="hidden", name="flowerId", value=flower._id.toString())
                        button.btn-hero-action(type="submit" style="background: #ff9f43; color: white;") #[i.fas.fa-cart-plus]
                    else
                      button.btn-hero-action(disabled style="background: #ccc; color: white; cursor: not-allowed;") #[i.fas.fa-ban]
            else
              .empty-state
                i.fas.fa-cake
                p Đang cập nhật những mẫu hoa chúc mừng sinh nhật mới...

      //- 5. HOA SỰ KIỆN & HỘI NGHỊ (Odd - Banner Trái)
      section.zigzag-section
        .section-banner.reveal
          i.fas.fa-microphone-alt(style="color: #2c3e50;")
          h2 Hoa Sự Kiện & Hội Nghị
