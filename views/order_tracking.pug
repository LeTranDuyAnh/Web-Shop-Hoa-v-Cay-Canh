doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Theo dõi đơn hàng - FloraHub
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
    link(href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Quicksand:wght@300;400;500;600;700&display=swap", rel="stylesheet")
    style.
      :root {
        --pink-main: #FF85A1;
        --pink-soft: #FBB1BD;
        --pink-bg: #FFF0F3;
        --pink-dark: #E91E63;
        --text-dark: #4A4A4A;
        --blue-ship: #1976D2;
        --green-done: #388E3C;
      }
      body { font-family: 'Quicksand', sans-serif; background: var(--pink-bg); color: var(--text-dark); margin: 0; padding: 20px; }
      
      .navbar { 
        display: flex; justify-content: space-between; align-items: center; 
        padding: 15px 5%; background: white; border-radius: 50px;
        margin-bottom: 40px; box-shadow: 0 5px 20px rgba(255, 133, 161, 0.1);
      }
      .logo { font-family: 'Dancing Script', cursive; font-size: 2rem; color: var(--pink-main); text-decoration: none; }

      .tracking-container { max-width: 850px; margin: 0 auto; }
      
      /* Search Section */
      .search-box { 
        background: white; padding: 40px; border-radius: 30px; 
        text-align: center; margin-bottom: 40px; box-shadow: 0 10px 30px rgba(255, 133, 161, 0.05);
      }
      .search-box h2 { font-family: 'Dancing Script', cursive; font-size: 2.5rem; color: var(--pink-main); margin-bottom: 20px; }
      
      .input-group { display: flex; gap: 10px; max-width: 500px; margin: 0 auto; }
      .form-control { 
        flex: 1; padding: 15px 25px; border: 2px solid var(--pink-bg); 
        border-radius: 50px; outline: none; transition: 0.3s; font-family: 'Quicksand';
      }
      .form-control:focus { border-color: var(--pink-main); box-shadow: 0 0 0 4px rgba(255, 133, 161, 0.1); }
      
      .btn { padding: 12px 25px; border-radius: 50px; font-weight: 700; border: none; cursor: pointer; transition: 0.3s; text-decoration: none; }
      .btn-primary { background: var(--pink-main); color: white; box-shadow: 0 5px 15px rgba(255, 133, 161, 0.2); }
      .btn-primary:hover { background: var(--pink-dark); transform: translateY(-2px); }

      /* Order Card */
      .order-card { 
        background: white; border-radius: 25px; padding: 30px; margin-bottom: 25px; 
        box-shadow: 0 10px 25px rgba(0,0,0,0.03); border-left: 6px solid var(--pink-soft);
        position: relative;
      }

      /* ĐỒNG BỘ TRẠNG THÁI */
      .status-tag { padding: 8px 18px; border-radius: 50px; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; display: inline-flex; align-items: center; gap: 6px; }
      .st-pending { background: #FFF9C4; color: #FBC02D; }
      .st-shipping { background: #E3F2FD; color: var(--blue-ship); }
      .st-completed { background: #C8E6C9; color: var(--green-done); }
      .st-cancelled { background: #FFCDD2; color: #D32F2F; }

      .item-list { background: var(--pink-bg); border-radius: 20px; padding: 20px; margin: 20px 0; }
      .item-row { display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 0.95rem; }
      
      .feedback-box { 
        margin-top: 20px; padding: 15px 20px; background: #fff5f7; 
        border-radius: 15px; border: 1px dashed var(--pink-main);
      }

      .back-home-btn { 
        display: inline-flex; align-items: center; gap: 8px; color: var(--pink-main); 
        text-decoration: none; margin-bottom: 20px; font-weight: 700; transition: 0.3s;
      }
      .back-home-btn:hover { color: var(--pink-dark); transform: translateX(-5px); }

  body
    header: nav.navbar
      a.logo(href="/") FloraHub
      a.btn.btn-primary(href="/explore" style="font-size: 0.8rem;") Mua thêm hoa

    .tracking-container
      a.back-home-btn(href="/")
        i.fas.fa-arrow-left
        | Quay về trang chủ

      .search-box
        h2 Tra cứu đơn hàng
        p(style="color: #888; margin-bottom: 25px;") Nhập số điện thoại của bạn để xem hành trình những đóa hoa.
        form(action="/track-order" method="GET")
          .input-group
            input.form-control(name="phone" value=searchedPhone placeholder="Ví dụ: 0987xxxxxx" required)
            button.btn.btn-primary(type="submit")
              i.fas.fa-search

      if orders && orders.length > 0
        each order in orders
          .order-card
            div(style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap: wrap; gap: 15px;")
              div
                span(style="color: var(--pink-main); font-weight: 800; font-size: 1.2rem;") ##{order._id.toString().slice(-8).toUpperCase()}
                p(style="margin: 5px 0; color: #aaa; font-size: 0.85rem;")
                  i.far.fa-calendar-alt(style="margin-right: 5px;")
                  | Ngày đặt: #{new Date(order.createdAt).toLocaleString('vi-VN')}
              
              div(style="text-align: right;")
                - var stClass = `st-${order.status}`
                span(class=`status-tag ${stClass}`)
                  if order.status === 'pending'
                    i.fas.fa-clock
                    | Đang chuẩn bị
                  else if order.status === 'shipping'
                    i.fas.fa-truck
                    | Đang giao hoa
                  else if order.status === 'completed'
                    i.fas.fa-check-double
                    | Đã giao xong
                  else
                    i.fas.fa-ban
                    | Đã hủy đơn
            
            //- Hiển thị phản hồi nếu đơn bị hủy
            if order.status === 'cancelled' && order.adminFeedback
              .feedback-box
                p(style="margin:0; font-size: 0.9rem; line-height: 1.5;") 
                  strong <i class="fas fa-comment-dots" style="color: var(--pink-main);"></i> Phản hồi từ FloraHub: 
                  span(style="color: #666;")= order.adminFeedback
            
            .item-list
              h5(style="margin-top:0; margin-bottom:15px; font-weight: 800; font-size: 0.9rem; color: #888; text-transform: uppercase;") Chi tiết sản phẩm
              each item in order.items
                .item-row
                  span(style="font-weight: 600;") #{item.name} 
                    small(style="color: var(--pink-main);") x#{item.qty}
                  span(style="font-weight: 700;") #{(item.price * item.qty).toLocaleString('vi-VN')} đ
              
              div(style="margin-top: 15px; padding-top: 15px; border-top: 1px solid rgba(255,133,161,0.2); display:flex; justify-content:space-between; font-weight:800; font-size: 1.1rem;")
                span Tổng thanh toán:
                span(style="color: var(--pink-dark);") #{order.totalAmount.toLocaleString('vi-VN')} đ

            //- Phần thông báo trạng thái chi tiết cho khách
            div(style="margin-top: 15px; display: flex; justify-content: space-between; align-items: center;")
              if order.status === 'pending'
                p(style="margin:0; font-size: 0.85rem; color: #888;") 
                  i.fas.fa-info-circle
                  |  Đơn hàng đang chờ shop xác nhận và bó hoa.
                a(href=`/order/cancel/${order._id}`, style="color: #aaa; text-decoration: none; font-size: 0.85rem; font-weight: 600;" onclick="return confirm('Gửi yêu cầu hủy đơn này?')") 
                  i.fas.fa-trash-alt(style="margin-right: 5px;")
                  | Hủy đơn
              
              else if order.status === 'shipping'
                p(style="margin:0; font-size: 0.85rem; color: var(--blue-ship); font-weight: 700;") 
                  i.fas.fa-shipping-fast
                  |  Tuyệt vời! Hoa của bạn đang trên đường tới rồi nhé.
              
              else if order.status === 'completed'
                p(style="margin:0; font-size: 0.85rem; color: var(--green-done); font-weight: 700;") 
                  i.fas.fa-heart
                  |  Đơn hàng đã giao thành công. Chúc bạn một ngày tốt lành!

        div(style="text-align: center; margin-top: 40px;")
          a.btn.btn-primary(href="/" style="padding: 15px 40px;") <i class="fas fa-shopping-cart" style="margin-right: 8px;"></i> Tiếp tục mua sắm
      
      else if searchedPhone
        div(style="text-align:center; padding: 60px 20px; background: white; border-radius: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.02);")
          img(src="https://cdn-icons-png.flaticon.com/512/6598/6598519.png" style="width: 100px; opacity: 0.5; margin-bottom: 20px;")
          p(style="font-weight: 600; color: #888;") Không tìm thấy đơn hàng nào gắn với số điện thoại này.
          a.btn.btn-primary(href="/" style="margin-top: 20px; display: inline-block;") Quay về trang chủ

    footer(style="text-align: center; margin-top: 60px; color: #aaa; font-size: 0.8rem; padding-bottom: 40px;")
      p &copy; 2026 VNUA FloraHub. Lan tỏa yêu thương trong từng khoảnh khắc.