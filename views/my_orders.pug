doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Đơn hàng của tôi - VNUA FloraHub
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
    link(href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Quicksand:wght@400;600;700&display=swap", rel="stylesheet")
    style.
      :root {
        --pink-main: #FF85A1;
        --pink-bg: #FFF0F3;
        --text-dark: #4A4A4A;
      }
      body { font-family: 'Quicksand', sans-serif; background: #fafafa; color: var(--text-dark); margin: 0; }
      
      /* Header đơn giản */
      .simple-nav { 
        background: white; padding: 15px 5%; 
        display: flex; justify-content: space-between; align-items: center;
        border-bottom: 1px solid #eee;
      }
      .logo-small { font-family: 'Dancing Script', cursive; font-size: 1.8rem; color: var(--pink-main); text-decoration: none; }

      .container { max-width: 800px; margin: 40px auto; padding: 0 20px; min-height: 50vh; }
      h2 { font-weight: 700; margin-bottom: 30px; display: flex; align-items: center; gap: 10px; }
      
      /* Card đơn giản */
      .order-item-card {
        background: white; border-radius: 15px; padding: 20px; margin-bottom: 20px;
        border: 1px solid #eee; transition: 0.2s;
      }
      .order-item-card:hover { border-color: var(--pink-main); }
      
      .order-header { display: flex; justify-content: space-between; border-bottom: 1px solid #f5f5f5; padding-bottom: 10px; margin-bottom: 15px; }
      .order-id { font-weight: 700; font-size: 0.9rem; color: #888; }
      
      .status { font-size: 0.8rem; font-weight: 700; padding: 4px 12px; border-radius: 50px; }
      .status-pending { background: #fff4e6; color: #fd7e14; }
      .status-completed { background: #ebfbee; color: #40c057; }
      .status-cancelled { background: #f8f9fa; color: #adb5bd; }

      .product-line { display: flex; justify-content: space-between; font-size: 0.95rem; margin-bottom: 8px; }
      .total-price { text-align: right; font-weight: 700; color: var(--pink-main); font-size: 1.2rem; margin-top: 15px; }
      
      .btn-back { color: #888; text-decoration: none; font-size: 0.9rem; font-weight: 600; }
      .btn-back:hover { color: var(--pink-main); }

  body
    nav.simple-nav
      a.logo-small(href="/") FloraHub
      a.btn-back(href="/") </i> Quay lại cửa hàng

    .container
      h2 Lịch sử đơn hàng
      
      if orders && orders.length > 0
        each order in orders
          .order-item-card
            .order-header
              span.order-id ##{order._id.toString().substring(18).toUpperCase()}
              div
                if order.status === 'pending'
                  span.status.status-pending Đang xử lý
                else if order.status === 'completed'
                  span.status.status-completed Hoàn thành
                else
                  span.status.status-cancelled Đã hủy
            
            .order-details
              p(style="font-size: 0.85rem; color: #888; margin-bottom: 10px;") Ngày đặt: #{new Date(order.createdAt).toLocaleDateString('vi-VN')}
              each item in order.items
                .product-line
                  span #{item.name} x#{item.qty}
                  span #{ (item.price * item.qty).toLocaleString('vi-VN') }đ
            
            .total-price
              span(style="font-size: 0.9rem; color: #888; font-weight: 400;") Tổng cộng: 
              | #{order.totalAmount.toLocaleString('vi-VN')}đ
      else
        div(style="text-align: center; padding: 50px; color: #bbb;")
          p Bạn chưa có đơn hàng nào.

    //- GIỮ NGUYÊN FOOTER
    footer(style="background: white; padding: 60px 8% 40px; border-top: 1px solid #eee; margin-top: 50px;")
      div(style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 40px;")
        div
          a(href="/" style="font-family: 'Dancing Script', cursive; font-size: 2rem; color: var(--pink-main); text-decoration: none;") FloraHub
          p(style="margin-top: 20px; line-height: 1.8; color: #888; font-size: 0.9rem;") VNUA FloraHub mang đến những đóa hoa tươi thắm nhất, thay bạn gửi gắm yêu thương đến những người trân quý.
        
        div
          h4(style="margin-bottom: 20px; font-weight: 800; color: #333;") Dịch Vụ
          ul(style="list-style: none; line-height: 2; padding: 0;")
            li: a(href="/" style="text-decoration: none; color: #777;") Trang chủ
            li: a(href="/explore" style="text-decoration: none; color: #777;") Shop hoa
            li: a(href="/vouchers" style="text-decoration: none; color: #777;") Kho Vouchers
            li: a(href="/my-orders" style="text-decoration: none; color: #777;") Lịch sử đặt hàng
        
        div
          h4(style="margin-bottom: 20px; font-weight: 800; color: #333;") Liên Hệ
          ul(style="list-style: none; color: #777; font-size: 0.9rem; line-height: 2; padding: 0;")
            li <i class="fas fa-map-marker-alt" style="color: var(--pink-main); margin-right: 10px;"></i> Trâu Quỳ, Gia Lâm, Hà Nội
            li <i class="fas fa-phone-alt" style="color: var(--pink-main); margin-right: 10px;"></i> 0123 456 789
      
      div(style="text-align: center; margin-top: 60px; padding-top: 20px; border-top: 1px solid #f2f2f2; color: #bbb; font-size: 0.8rem;")
        p &copy; 2026 VNUA FloraHub. Thiết kế bởi FloraHub Team.