            li: a(href="/wiki" style="text-decoration: none; color: #777;") Cẩm nang
            li: a(href="/vouchers" style="text-decoration: none; color: #777;") Kho vouchers
            li: a(href="/blog" style="text-decoration: none; color: #777;") Tin tức
