        i.fas.fa-comment-alt
      a.chat-btn.messenger(href="#", title="Chat qua Messenger")
        i.fab.fa-facebook-messenger


    script.
      document.addEventListener('DOMContentLoaded', () => {
        // Slider Logic
        const slides = document.querySelectorAll('.slide');
        let current = 0;
        if(slides.length > 0) {
          setInterval(() => {
            slides[current].classList.remove('active');
            current = (current + 1) % slides.length;
            slides[current].classList.add('active');
          }, 5000); 
        }

        // Search Logic
        const searchInput = document.getElementById('searchInput');
        const items = document.querySelectorAll('.flower-item');
        const countDisp = document.getElementById('resultCount');
        
        searchInput.addEventListener('input', (e) => {
          const val = e.target.value.toLowerCase();
          let count = 0;
          items.forEach(el => {
            const match = el.innerText.toLowerCase().includes(val);
            el.style.display = match ? "" : "none";
            if(match) count++;
          });
          if(countDisp) countDisp.innerText = count;
        });
      });
      script.
        window.addEventListener('scroll', function() {
          const navbar = document.querySelector('.navbar');
          // Khi cuộn xuống quá 50px thì thêm class 'scrolled'
          if (window.scrollY > 50) {
            navbar.classList.add('scrolled');
          } else {
            navbar.classList.remove('scrolled');
          }
        });