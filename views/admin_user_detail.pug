doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    title Chi tiết quản trị viên - FloraHub
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
    link(href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600;700;800&display=swap", rel="stylesheet")
    style.
      :root { --pink-main: #E91E63; --pink-dark: #C2185B; --pink-bg: #F8BBD0; }
      body { font-family: 'Quicksand', sans-serif; background: #fdf2f4; margin: 0; padding: 40px; color: #2d3436; }
      .container { max-width: 1000px; margin: auto; }
      .card { background: white; border-radius: 25px; padding: 35px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); border: 2px solid var(--pink-bg); }
      .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; border-bottom: 2px solid #fce4ec; padding-bottom: 20px; }
      .info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 25px; margin-bottom: 40px; }
      .info-item label { color: #aaa; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; }
      .info-item p { font-weight: 700; margin: 8px 0; color: var(--pink-dark); font-size: 1.1rem; }
      .badge { background: var(--pink-bg); color: var(--pink-dark); padding: 5px 15px; border-radius: 50px; font-size: 0.8rem; }
      .table { width: 100%; border-collapse: collapse; margin-top: 20px; }
      .table th { text-align: left; padding: 12px; color: #bbb; border-bottom: 2px solid #fce4ec; }
      .table td { padding: 15px 12px; border-bottom: 1px solid #eee; }
      .btn-back { text-decoration: none; color: #888; font-weight: 700; display: flex; align-items: center; gap: 8px; transition: 0.3s; }
      .btn-back:hover { color: var(--pink-main); }
      .status-done { color: #2ecc71; font-weight: 700; }

  body
    .container
      .card
        .header
          div
            h1(style="margin:0; color: var(--pink-dark);") 
              i.fas.fa-id-badge(style="margin-right: 15px;")
              | Hồ sơ: #{user.fullName}
            p(style="color: #999; margin-top: 5px;") ID: #{user._id}
          a.btn-back(href="/admin/users") 
            i.fas.fa-arrow-left
            | Quay lại danh sách

        .info-grid
          .info-item
            label Tên đăng nhập
            p= user.username
          .info-item
            label Vai trò hệ thống
            p: span.badge= user.role.toUpperCase()
          .info-item
            label Số điện thoại
            p= user.phone || "Chưa cập nhật"
          .info-item
            label Địa chỉ
            p= user.address || "Chưa cập nhật"

        h3(style="color: var(--pink-main); border-left: 5px solid var(--pink-main); padding-left: 15px;") <i class="fas fa-shopping-bag"></i> Lịch sử đơn hàng đã xử lý
        
        if orders && orders.length > 0
          table.table
            thead
              tr
                th Mã đơn
                th Ngày đặt
                th Người nhận
                th Tổng tiền
                th Trạng thái
            tbody
              each order in orders
                tr
                  td(style="font-weight:700")= "#" + order._id.toString().slice(-6)
                  td= new Date(order.createdAt).toLocaleDateString('vi-VN')
                  td= order.customer ? order.customer.name : "N/A"
                  td(style="color: var(--pink-main); font-weight:700")= order.totalAmount.toLocaleString() + "đ"
                  td: span.status-done= order.status === 'completed' ? 'Hoàn thành' : 'Đang xử lý'
        else
          .empty(style="text-align: center; padding: 50px; color: #ccc;")
            i.fas.fa-box-open(style="font-size: 3rem; margin-bottom: 15px;")
            p Người dùng này chưa có dữ liệu đơn hàng.