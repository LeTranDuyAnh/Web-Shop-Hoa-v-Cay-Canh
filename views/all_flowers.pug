doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Shop Hoa - VNUA FloraHub
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
    link(href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Quicksand:wght@300;400;500;600;700&display=swap", rel="stylesheet")
    style.
      :root {
        --pink-main: #FF85A1;
        --pink-dark: #E91E63;
        --pink-soft: #FBB1BD;
        --pink-bg: #FFF0F3;
        --text-dark: #4A4A4A;
        --white: #FFFFFF;
        --gray-out: #b2bec3;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Quicksand', sans-serif; background: var(--pink-bg); color: var(--text-dark); overflow-x: hidden; scroll-behavior: smooth; }
      
      /* --- NAVBAR --- */
      .navbar { 
        display: flex; justify-content: space-between; align-items: center; 
        padding: 12px 5%; background: rgba(255, 255, 255, 0.98); 
        position: sticky; top: 0; z-index: 1000; box-shadow: 0 2px 15px rgba(0,0,0,0.05); 
      }
      .logo { font-family: 'Dancing Script', cursive; font-size: 2.2rem; color: var(--pink-main); text-decoration: none; }
      .nav-menu { display: flex; list-style: none; gap: 15px; align-items: center; }
      .nav-link { 
        text-decoration: none; color: var(--text-dark); font-weight: 700; 
        font-size: 0.9rem; padding: 8px 20px; transition: 0.3s; border-radius: 50px;
      }
      .nav-link.active { background: var(--pink-main); color: white; box-shadow: 0 4px 10px rgba(255, 133, 161, 0.3); }
      .nav-link:not(.active):hover { color: var(--pink-main); }
      
      .nav-right { display: flex; align-items: center; gap: 15px; }
      .icon-btn { color: var(--pink-main); font-size: 1.2rem; text-decoration: none; position: relative; transition: 0.3s; }
      .cart-count { background: #ff4757; color: white; border-radius: 50%; padding: 2px 6px; font-size: 0.65rem; position: absolute; top: -8px; right: -8px; border: 2px solid white; }
      .btn-exit { background: #4A4A4A; color: white; padding: 8px 18px; border-radius: 50px; text-decoration: none; font-weight: 700; font-size: 0.8rem; }

      /* --- BANNER --- */
      .hero-slider { position: relative; height: 70vh; min-height: 450px; width: 100%; overflow: hidden; background: #fce4ec; }
      .slide { 
        position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; 
        transition: opacity 1s ease-in-out; display: flex; align-items: center; padding: 0 10%; 
        background-size: cover; background-position: center; z-index: 1;
      }
      .slide.active { opacity: 1; z-index: 2; }
      .hero-content { position: relative; z-index: 10; max-width: 500px; }
      .hero-content h1 { font-family: 'Dancing Script', cursive; font-size: 4rem; color: var(--pink-main); margin-bottom: 15px; text-shadow: 2px 2px 4px rgba(255,255,255,0.8); }
      .hero-content p { font-size: 1.1rem; font-weight: 600; color: #555; }

      /* --- SEARCH BOX --- */
      .search-container { max-width: 600px; margin: -35px auto 30px; padding: 0 20px; position: relative; z-index: 100; }
      .search-box {
        background: white; display: flex; align-items: center; padding: 5px 25px;
        border-radius: 100px; box-shadow: 0 15px 35px rgba(255, 133, 161, 0.2);
        border: 2px solid var(--pink-bg);
      }
      .search-box input { border: none; outline: none; padding: 15px; width: 100%; font-family: 'Quicksand'; font-size: 1rem; }
      .search-box i { color: var(--pink-main); font-size: 1.2rem; }

      /* --- CATEGORY QUICK FILTER --- */
      .category-nav { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin-bottom: 40px; padding: 0 5%; position: relative; z-index: 10; }
      .filter-chip { 
        padding: 8px 18px; background: white; border: 2px solid var(--pink-soft); border-radius: 50px; 
        color: var(--pink-dark); text-decoration: none; font-weight: 700; font-size: 0.85rem; transition: 0.3s;
      }
      .filter-chip:hover { background: var(--pink-bg); transform: translateY(-2px); }
      .filter-chip.active { background: var(--pink-main); color: white; border-color: var(--pink-main); box-shadow: 0 5px 12px rgba(255, 133, 161, 0.3); }

      /* --- PRODUCT SECTION --- */
      section.content { 
        padding: 60px 8% 100px; background: white; border-radius: 60px 60px 0 0; 
        margin-top: -40px; position: relative; z-index: 5; min-height: 500px;
      }
      .category-block { margin-bottom: 60px; scroll-margin-top: 100px; }
      .category-header { display: flex; align-items: center; gap: 20px; margin-bottom: 30px; }
      .category-header h2 { font-family: 'Dancing Script', cursive; font-size: 2.2rem; color: var(--pink-dark); white-space: nowrap; }
      .category-header .line { height: 2px; background: linear-gradient(to right, var(--pink-soft), transparent); width: 100%; }

      .grid-container { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 25px; }
      
      .product-card { 
        background: var(--white); border-radius: 25px; padding: 15px; 
        text-align: center; transition: 0.4s; border: 1px solid #fef0f2;
        position: relative; overflow: hidden; display: flex; flex-direction: column;
      }
      .product-card:hover { transform: translateY(-10px); box-shadow: 0 12px 25px rgba(255, 133, 161, 0.15); }
      .product-card img { width: 100%; height: 240px; object-fit: cover; border-radius: 20px; margin-bottom: 15px; }

      .card-body h3 { 
        margin-bottom: 8px; font-weight: 700; font-size: 1rem; color: #333;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; 
        overflow: hidden; min-height: 2.5rem;
      }

      /* --- SOLD OUT STATE --- */
      .sold-out-card { filter: grayscale(0.8); opacity: 0.7; }
      .sold-out-badge {
        position: absolute; top: 15px; left: 15px; background: #636e72; color: white;
        padding: 5px 12px; border-radius: 50px; font-weight: 800; font-size: 0.7rem; z-index: 5;
      }
      
      /* --- BUTTONS --- */
      .btn-hero { 
        padding: 10px 20px; border-radius: 50px; background: var(--pink-main); color: white; 
        font-weight: 700; text-decoration: none; display: inline-block; transition: 0.3s;
        box-shadow: 0 4px 12px rgba(255, 133, 161, 0.3); border: none; cursor: pointer; font-size: 0.9rem;
      }
      .btn-hero:hover:not(:disabled) { transform: translateY(-2px); background: var(--pink-dark); }
      .btn-detail { background: #f8f9fa; color: #777; box-shadow: none; }
      .btn-disabled { background: var(--gray-out) !important; cursor: not-allowed !important; box-shadow: none !important; }

      .social-chat-wrapper { position: fixed; bottom: 30px; right: 30px; z-index: 999; display: flex; flex-direction: column; gap: 15px; }
      .chat-btn { width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; text-decoration: none; font-size: 1.5rem; box-shadow: 0 5px 15px rgba(0,0,0,0.2); transition: 0.3s; }
      .chat-btn.zalo { background: #0084ff; }
      .chat-btn.messenger { background: #00c6ff; }
      .chat-btn img { width: 100%; border-radius: 50%; }

  body
    header
      nav.navbar
        a.logo(href="/") FloraHub
        ul.nav-menu
          li: a.nav-link(href="/") Trang chủ
          li: a.nav-link.active(href="/explore") Shop Hoa
          li: a.nav-link(href="/wiki") Cẩm nang
          li: a.nav-link(href="/vouchers") Kho Vouchers
          li: a.nav-link(href="/blog") Tin tức
        .nav-right
          a.icon-btn(href="/cart")
            i.fas.fa-shopping-basket
            if cartCount > 0
              span.cart-count= cartCount
          
          if session && session.user
            if session.user.role === 'admin'
              a.icon-btn(href="/admin" title="Quản trị"): i.fas.fa-user-shield
            a.icon-btn(href="/profile" title="Tài khoản"): i.fas.fa-user-circle
            a.btn-exit(href="/logout") Thoát
          else
            a.nav-link(href="/login" style="padding: 8px 15px") Đăng nhập

    main
      section.hero-slider
        .slide.active(style="background-image: linear-gradient(to right, rgba(255,240,243,0.8), rgba(255,240,243,0.2)), url('https://images.unsplash.com/photo-1526047932273-341f2a7631f9?auto=format&fit=crop&q=80&w=1600');")
          .hero-content
            h1 Bloom with Love
            p Những bó hoa thiết kế thủ công tinh tế nhất dành cho phái đẹp.
            br
            a.btn-hero(href="#flowerSearch") Ghé Thăm Shop Ngay
            
        .slide(style="background-image: linear-gradient(to right, rgba(255,240,243,0.8), rgba(255,240,243,0.2)), url('https://images.unsplash.com/photo-1490750967868-88aa4486c946?auto=format&fit=crop&q=80&w=1600');")
          .hero-content
            h1 Sweet Moments
            p Trao gửi chân tình qua từng sắc hoa rực rỡ và dịu dàng.
            br
            a.btn-hero(href="#flowerSearch") Khám phá cửa hàng

        .slide(style="background-image: linear-gradient(to right, rgba(255,240,243,0.8), rgba(255,240,243,0.2)), url('https://images.unsplash.com/photo-1464851707681-f9d5fdaccea8?auto=format&fit=crop&q=80&w=1600');")
          .hero-content
            h1 Plant Library
            p Tìm hiểu cách chăm sóc hoa qua cẩm nang của chúng tôi.
            br
            a.btn-hero(href="/wiki") Khám phá cẩm nang  

      .search-container
        .search-box
          i.fas.fa-search
          input#flowerSearch(type="text", placeholder="Tìm tên hoa trong cửa hàng...", onkeyup="filterFlowers()")

      if groupedFlowers && Object.keys(groupedFlowers).length > 1
        .category-nav
          a.filter-chip.active(href="javascript:void(0)" onclick="scrollToCat('all')") Tất cả
          each categoryName in Object.keys(groupedFlowers)
            a.filter-chip(href=`#cat-${categoryName.replace(/\s+/g, '-')}` onclick=`scrollToCat('cat-${categoryName.replace(/\\s+/g, '-')}')`)= categoryName

      section.content
        if groupedFlowers && Object.keys(groupedFlowers).length > 0
          each categoryName in Object.keys(groupedFlowers)
            .category-block(id=`cat-${categoryName.replace(/\s+/g, '-')}`)
              .category-header
                h2= categoryName
                .line
              
              .grid-container
                each flower in groupedFlowers[categoryName]
                  - var isOut = (flower.stock <= 0)
                  .product-card.flower-item(class=(isOut ? "sold-out-card" : ""))
                    if isOut
                      span.sold-out-badge HẾT HÀNG

                    img(src=(flower.image || 'https://via.placeholder.com/300x400?text=FloraHub'))
                    .card-body
                      h3= flower.name
                      p(style="color: var(--pink-main); font-weight: 800; font-size: 1.2rem; margin-bottom: 15px;")= (flower.price ? flower.price.toLocaleString('vi-VN') + ' đ' : 'Liên hệ')
                      
                      .card-footer(style="display: flex; gap: 8px; justify-content: center;")
                        a.btn-hero.btn-detail(href=`/flower/${flower._id}`) Chi tiết
                        if !isOut
                          form(action="/cart/add", method="POST")
                            input(type="hidden", name="flowerId", value=flower._id.toString())
                            button.btn-hero(type="submit" title="Thêm vào giỏ") #[i.fas.fa-cart-plus]
                        else
                          button.btn-hero.btn-disabled(disabled) #[i.fas.fa-ban]
        else
          div(style="text-align: center; padding: 100px 0;")
            i.fas.fa-seedling(style="font-size: 3rem; color: var(--pink-soft); margin-bottom: 20px;")
            p(style="color: #999;") Hiện tại chưa có sản phẩm nào trong danh mục này.

    footer(style="background: var(--white); padding: 80px 8% 40px; border-top: 5px solid var(--pink-bg);")
      div(style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 40px;")
        div
          a.logo(href="/") FloraHub
          p(style="margin-top: 20px; line-height: 1.8; color: #888; font-size: 0.9rem;") VNUA FloraHub mang đến những đóa hoa tươi thắm nhất, thay bạn gửi gắm yêu thương đến những người trân quý.
        
        div
          h4(style="margin-bottom: 20px; font-weight: 800; color: #333;") Dịch Vụ
          ul(style="list-style: none; line-height: 2;")
            li: a(href="/" style="text-decoration: none; color: #777;") Trang chủ
            li: a(href="/explore" style="text-decoration: none; color: #777;") Shop hoa
            li: a(href="/wiki" style="text-decoration: none; color: #777;") Cẩm nang
            li: a(href="/vouchers" style="text-decoration: none; color: #777;") Kho vouchers
            li: a(href="/blog" style="text-decoration: none; color: #777;") Tin tức
            li: a(href="/my-orders" style="text-decoration: none; color: #777;") Lịch sử đặt hàng
            li: a(href="/track-order" style="text-decoration: none; color: #777;") Theo dõi đơn
        
        div
          h4(style="margin-bottom: 20px; font-weight: 800; color: #333;") Liên Hệ
          ul(style="list-style: none; color: #777; font-size: 0.9rem; line-height: 2;")
            li <i class="fas fa-map-marker-alt" style="color: var(--pink-main); margin-right: 10px;"></i> Trâu Quỳ, Gia Lâm, Hà Nội
            li <i class="fas fa-phone-alt" style="color: var(--pink-main); margin-right: 10px;"></i> 0123 456 789
      
      div(style="text-align: center; margin-top: 60px; padding-top: 20px; border-top: 1px solid #f2f2f2; color: #bbb; font-size: 0.8rem;")
        p &copy; 2026 VNUA FloraHub. Thiết kế bởi FloraHub Team.

    .social-chat-wrapper
      a.chat-btn.zalo(href="https://zalo.me/0398102869" target="_blank"): img(src="https://upload.wikimedia.org/wikipedia/commons/9/91/Icon_Zalo.svg")
      a.chat-btn.messenger(href="#" target="_blank"): i.fab.fa-facebook-messenger

    script.
      document.addEventListener('DOMContentLoaded', () => {
        const slides = document.querySelectorAll('.slide');
        let current = 0;
        if(slides.length > 0) {
          slides[0].classList.add('active');
          setInterval(() => {
            slides[current].classList.remove('active');
            current = (current + 1) % slides.length;
            slides[current].classList.add('active');
          }, 4000); 
        }
      });

      function filterFlowers() {
        const input = document.getElementById('flowerSearch');
        const filter = input.value.toLowerCase();
        const blocks = document.querySelectorAll('.category-block');
        
        blocks.forEach(block => {
          const items = block.querySelectorAll('.flower-item');
          let hasVisibleItem = false;
          
          items.forEach(item => {
            let name = item.querySelector('h3').innerText.toLowerCase();
            if (name.includes(filter)) {
              item.style.display = "";
              hasVisibleItem = true;
            } else {
              item.style.display = "none";
            }
          });
          
          block.style.display = hasVisibleItem ? "" : "none";
        });
      }

      function scrollToCat(id) {
        if(id === 'all') {
          window.scrollTo({ top: document.querySelector('.search-container').offsetTop - 20, behavior: 'smooth' });
        } else {
          const el = document.getElementById(id);
          if(el) el.scrollIntoView({ behavior: 'smooth' });
        }
        
        // Cập nhật trạng thái active cho chip
        document.querySelectorAll('.filter-chip').forEach(chip => chip.classList.remove('active'));
        event.currentTarget.classList.add('active');
      }