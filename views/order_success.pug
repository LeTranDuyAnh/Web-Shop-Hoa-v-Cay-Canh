doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Đặt hàng thành công - FloraHub
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
    link(href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Quicksand:wght@300;400;500;600;700&display=swap", rel="stylesheet")
    style.
      :root {
        --pink-main: #FF85A1; --pink-dark: #E91E63; --pink-soft: #FBB1BD;
        --pink-bg: #FFF0F3; --text-dark: #4A4A4A;
      }
      body { font-family: 'Quicksand', sans-serif; background: var(--pink-bg); color: var(--text-dark); margin: 0; padding: 20px; }
      .navbar { display: flex; justify-content: center; padding: 15px; background: white; border-radius: 50px; max-width: 200px; margin: 0 auto 30px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
      .logo { font-family: 'Dancing Script', cursive; font-size: 1.8rem; color: var(--pink-main); text-decoration: none; }
      .success-card { max-width: 750px; margin: 0 auto; background: white; padding: 45px; border-radius: 35px; box-shadow: 0 15px 40px rgba(255, 133, 161, 0.15); }
      .check-icon { width: 80px; height: 80px; background: var(--pink-bg); color: var(--pink-main); display: flex; align-items: center; justify-content: center; border-radius: 50%; margin: 0 auto 20px; font-size: 2.5rem; }
      .order-details { background: #fff; border: 2px solid var(--pink-bg); border-radius: 20px; padding: 25px; margin: 25px 0; }
      .detail-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px dashed var(--pink-bg); font-size: 0.95rem; }
      h4 { color: var(--pink-dark); margin-bottom: 15px; font-weight: 800; display: flex; align-items: center; gap: 10px; }
      .btn-group { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 35px; }
      .btn { padding: 15px; border-radius: 50px; text-decoration: none; font-weight: 700; text-align: center; transition: 0.3s; font-size: 0.9rem; }
      .btn-primary { background: var(--pink-main); color: white; }
      .btn-outline { border: 2px solid var(--pink-soft); color: var(--pink-main); }

  body
    header: nav.navbar: a.logo(href="/") FloraHub

    .success-card
      div(style="text-align:center; margin-bottom: 30px;")
        .check-icon: i.fas.fa-heart
        h1(style="font-family: 'Dancing Script', cursive; color: var(--pink-main); font-size: 2.5rem;") Đặt hàng thành công!
        p Mã đơn hàng: 
          strong(style="color: var(--pink-dark);") ##{order._id.toString().slice(-8).toUpperCase()}

      //- THÔNG TIN GỬI & NHẬN (Nằm ngang)
      .order-details
        div(style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;")
          div
            h4 <i class="fas fa-user-circle"></i> Người gửi
            p(style="font-size: 0.9rem; margin: 5px 0;") <strong>#{order.senderName || 'Không xác định'}</strong>
            p(style="font-size: 0.9rem; margin: 5px 0;") SĐT: #{order.senderPhone || 'Chưa cập nhật'}
            p(style="font-size: 0.9rem; margin: 5px 0; color: #777;") ĐC: #{(user && user.address) || 'Chưa cập nhật địa chỉ'}
          
          div(style="border-left: 1px dashed var(--pink-bg); padding-left: 20px;")
            h4 <i class="fas fa-gift"></i> Người nhận
            p(style="font-size: 0.9rem; margin: 5px 0;") <strong>#{order.customer.name}</strong>
            p(style="font-size: 0.9rem; margin: 5px 0;") SĐT: #{order.customer.phone}
            p(style="font-size: 0.9rem; margin: 5px 0;") Thời gian: #{order.deliveryTime || 'Sớm nhất'}
        
        .detail-row(style="margin-top: 15px;")
          span Địa chỉ nhận:
          span(style="text-align: right; font-weight: 600; max-width: 60%;")= order.customer.address
        .detail-row
          span Lời nhắn:
          em(style="color: #666;")= order.note || 'Không có'

      //- TÓM TẮT CHI PHÍ
      .order-details(style="border: 2px solid var(--pink-main);")
        h4 <i class="fas fa-receipt"></i> Tóm tắt đơn hàng
        each item in order.items
          .detail-row
            span #{item.name} (x#{item.qty})
            span= (item.price * item.qty).toLocaleString('vi-VN') + ' đ'
        .detail-row(style="font-weight: 800; font-size: 1.3rem; color: var(--pink-dark); margin-top: 10px; border-top: 2px solid var(--pink-bg); padding-top: 10px;")
          span TỔNG CỘNG:
          span= order.totalAmount.toLocaleString('vi-VN') + ' đ'

      .btn-group
        a.btn.btn-outline(href="/") Tiếp tục mua
        a.btn.btn-primary(href="/") Về trang chủ