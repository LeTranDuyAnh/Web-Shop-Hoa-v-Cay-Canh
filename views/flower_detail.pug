doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title #{flower.name} - VNUA FloraHub
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
    //- Đồng bộ Font với trang Wiki (Be Vietnam Pro cho nội dung, Dancing Script cho tiêu đề)
    link(href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Quicksand:wght@700&display=swap", rel="stylesheet")
    style.
      :root {
        --pink-main: #FF85A1;
        --pink-dark: #E91E63;
        --pink-soft: #FBB1BD;
        --pink-bg: #FFF0F3;
        --text-dark: #2D3436;
        --white: #FFFFFF;
        --shadow: 0 15px 45px rgba(255, 133, 161, 0.12);
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { 
        font-family: 'Be Vietnam Pro', sans-serif; 
        background: var(--pink-bg); 
        color: var(--text-dark);
        line-height: 1.7;
      }
      
      /* --- NAVBAR SYNC --- */
      .navbar { 
        display: flex; justify-content: space-between; align-items: center; 
        padding: 15px 8%; background: rgba(255, 255, 255, 0.98); 
        position: sticky; top: 0; z-index: 1000; box-shadow: 0 2px 15px rgba(0,0,0,0.05); 
      }
      .logo { font-family: 'Dancing Script', cursive; font-size: 2.2rem; color: var(--pink-main); text-decoration: none; }
      .nav-links a { text-decoration: none; color: var(--text-dark); font-weight: 600; margin-left: 25px; transition: 0.3s; }
      .nav-links a:hover { color: var(--pink-main); }

      /* --- LAYOUT --- */
      .detail-container { padding: 50px 8%; max-width: 1400px; margin: 0 auto; }
      
      .breadcrumb { margin-bottom: 30px; font-size: 0.9rem; font-weight: 500; color: #888; }
      .breadcrumb a { color: var(--pink-main); text-decoration: none; }
      
      .flower-grid { 
        display: grid; 
        grid-template-columns: 1.1fr 0.9fr; 
        gap: 50px; 
        background: white; 
        padding: 40px; 
        border-radius: 50px; 
        box-shadow: var(--shadow);
      }
      
      /* --- IMAGE SECTION --- */
      .image-viewer { position: relative; }
      .main-img { 
        width: 100%; 
        height: 600px; 
        object-fit: cover; 
        border-radius: 40px; 
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        border: 8px solid var(--pink-bg);
      }

      /* --- INFO SECTION --- */
      .flower-info-box h1 { 
        font-family: 'Dancing Script', cursive; 
        font-size: 4rem; 
        color: var(--pink-main); 
        margin-bottom: 5px; 
      }
      .scientific-tag { 
        display: inline-block;
        font-style: italic; 
        color: var(--pink-soft); 
        font-size: 1.2rem; 
        margin-bottom: 30px; 
        font-weight: 500; 
      }

      .price-tag {
        font-size: 2.2rem;
        font-weight: 800;
        color: var(--pink-dark);
        margin-bottom: 30px;
        font-family: 'Quicksand', sans-serif;
      }

      .specs-group {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 40px;
      }
      .spec-card {
        background: var(--pink-bg);
        padding: 20px;
        border-radius: 25px;
        display: flex;
        align-items: center;
        gap: 15px;
      }
      .spec-card i { font-size: 1.5rem; color: var(--pink-main); }
      .spec-card div label { display: block; font-size: 0.75rem; font-weight: 700; color: #a5a5a5; text-transform: uppercase; }
      .spec-card div span { font-weight: 700; color: #444; font-size: 1rem; }

      .description-box {
        background: #fdfdfd;
        padding: 30px;
        border-radius: 30px;
        border: 1px dashed var(--pink-soft);
        margin-bottom: 40px;
      }
      .description-box h3 { 
        font-family: 'Quicksand', sans-serif; 
        font-size: 1.2rem; 
        margin-bottom: 15px; 
        color: var(--pink-dark);
      }

      /* --- BUTTONS --- */
      .action-btns { display: flex; gap: 15px; }
      .btn-main {
        flex: 1;
        padding: 20px;
        border-radius: 50px;
        border: none;
        background: var(--pink-main);
        color: white;
        font-weight: 700;
        font-size: 1.1rem;
        cursor: pointer;
        transition: 0.4s;
        box-shadow: 0 10px 25px rgba(255, 133, 161, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
      }
      .btn-main:hover:not(:disabled) { background: var(--pink-dark); transform: translateY(-5px); box-shadow: 0 15px 30px rgba(255, 133, 161, 0.5); }
      .btn-main:disabled { background: #d1d1d1; box-shadow: none; cursor: not-allowed; }

      .btn-wish {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        border: 2px solid var(--pink-bg);
        background: white;
        color: var(--pink-soft);
        font-size: 1.4rem;
        cursor: pointer;
        transition: 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .btn-wish:hover { color: var(--pink-dark); border-color: var(--pink-main); transform: scale(1.1); }

      @media (max-width: 1100px) {
        .flower-grid { grid-template-columns: 1fr; border-radius: 30px; }
        .main-img { height: 400px; }
      }

  body
    header
      nav.navbar
        a.logo(href="/") FloraHub
        .nav-links
          a(href="/") Trang chủ
          a(href="/explore") Cửa hàng
          a(href="/wiki") Cẩm nang
          a(href="/cart"): i.fas.fa-shopping-bag

    main.detail-container
      .breadcrumb
        a(href="/") Trang chủ
        span   /   
        a(href="/explore") Shop hoa
        span   /   #{flower.name}

      .flower-grid
        .image-viewer
          img.main-img(src=flower.image || '/public/uploads/default-flower.jpg', alt=flower.name)
          if flower.stock <= 0
            div(style="position: absolute; top: 30px; left: 30px; background: rgba(0,0,0,0.6); color: white; padding: 10px 25px; border-radius: 50px; font-weight: 700; backdrop-filter: blur(5px);") Tạm hết hàng

        .flower-info-box
          h1= flower.name
          span.scientific-tag= flower.scientific_name || 'Botanical Species'
          
          .price-tag= flower.price ? flower.price.toLocaleString('vi-VN') + ' VNĐ' : 'Liên hệ báo giá'

          .specs-group
            .spec-card
              i.fas.fa-tag
              div
                label Phân loại
                span= flower.category || 'Hoa tươi'
            .spec-card
              i.fas.fa-leaf
              div
                label Độ bền
                span 5 - 7 ngày tươi
            .spec-card
              i.fas.fa-box-open
              div
                label Tình trạng
                span.stock-status(class=flower.stock > 0 ? 'in-stock' : 'out-of-stock')
                  | #{flower.stock > 0 ? 'Còn hàng' : 'Hết hàng'}
            .spec-card
              i.fas.fa-shipping-fast
              div
                label Giao hàng
                span Nội thành 2h

          .description-box
            h3 #[i.fas.fa-quote-left.me-2] Ý nghĩa & Thông điệp
            p= flower.description || 'Loài hoa này không chỉ mang vẻ đẹp rực rỡ mà còn ẩn chứa những thông điệp yêu thương sâu sắc, thích hợp cho mọi dịp kỷ niệm.'

          .action-btns
            if flower.stock > 0
              form(action="/cart/add", method="POST" style="flex: 1;")
                input(type="hidden", name="flowerId", value=flower._id.toString())
                input(type="hidden", name="name", value=flower.name)
                input(type="hidden", name="price", value=flower.price || 0)
                input(type="hidden", name="image", value=flower.image)
                button.btn-main(type="submit")
                  i.fas.fa-shopping-basket
                  | Thêm vào giỏ hàng
            else
              button.btn-main(disabled)
                i.fas.fa-clock
                | Chờ nhập hàng
            
            button.btn-wish(title="Yêu thích")
              i.fas.fa-heart

    //- FOOTER 3 CỘT ĐỒNG BỘ
    footer(style="background: var(--white); padding: 80px 8% 40px; border-top: 5px solid var(--pink-bg);")
      div(style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 40px;")
        div
          a.logo(href="/") FloraHub
          p(style="margin-top: 20px; line-height: 1.8; color: #888; font-size: 0.9rem;") VNUA FloraHub mang đến những đóa hoa tươi thắm nhất, thay bạn gửi gắm yêu thương đến những người trân quý.
        
        div
          h4(style="margin-bottom: 20px; font-weight: 800; color: #333;") Dịch Vụ
          ul(style="list-style: none; line-height: 2;")
            li: a(href="/explore" style="text-decoration: none; color: #777;") Trang chủ
            li: a(href="/explore" style="text-decoration: none; color: #777;") Shop hoa
            li: a(href="/explore" style="text-decoration: none; color: #777;") Cẩm nang
            li: a(href="/blog" style="text-decoration: none; color: #777;") Blog
        
        div
          h4(style="margin-bottom: 20px; font-weight: 800; color: #333;") Liên Hệ
          ul(style="list-style: none; color: #777; font-size: 0.9rem; line-height: 2;")
            li <i class="fas fa-map-marker-alt" style="color: var(--pink-main); margin-right: 10px;"></i> Trâu Quỳ, Gia Lâm, Hà Nội
            li <i class="fas fa-phone-alt" style="color: var(--pink-main); margin-right: 10px;"></i> 0123 456 789
      
      div(style="text-align: center; margin-top: 60px; padding-top: 20px; border-top: 1px solid #f2f2f2; color: #bbb; font-size: 0.8rem;")
        p &copy; 2026 VNUA FloraHub. Thiết kế bởi FloraHub Team.