doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Hồ sơ cá nhân - VNUA FloraHub
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
    link(href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap", rel="stylesheet")
    style.
      :root {
        --pink-main: #FF85A1;
        --pink-bg: #FFF0F3;
        --text-dark: #4A4A4A;
        --text-muted: #888;
        --white: #FFFFFF;
      }
      body { 
        font-family: 'Quicksand', sans-serif; 
        background: var(--pink-bg); 
        color: var(--text-dark);
        margin: 0;
        padding: 40px 5%;
      }
      .profile-container {
        max-width: 1000px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 350px 1fr;
        gap: 30px;
      }
      /* Cột trái: Thông tin cá nhân */
      .profile-card { 
        background: var(--white); 
        padding: 40px 30px; 
        border-radius: 30px; 
        box-shadow: 0 10px 30px rgba(255, 133, 161, 0.1); 
        text-align: center;
        height: fit-content;
      }
      .avatar { 
        width: 90px; height: 90px; 
        background: linear-gradient(135deg, var(--pink-main), #ffb1bd); 
        color: white; border-radius: 50%; 
        display: flex; align-items: center; justify-content: center; 
        font-size: 2.2rem; margin: 0 auto 20px; font-weight: 700;
      }
      .info-list { text-align: left; margin-top: 25px; }
      .info-item { margin-bottom: 18px; border-bottom: 1px solid #f9f9f9; padding-bottom: 8px; }
      .info-label { font-size: 0.8rem; color: var(--text-muted); display: block; text-transform: uppercase; }
      .info-value { font-weight: 600; font-size: 0.95rem; }

      /* Cột phải: Đơn hàng */
      .orders-section {
        background: var(--white);
        padding: 35px;
        border-radius: 30px;
        box-shadow: 0 10px 30px rgba(255, 133, 161, 0.1);
      }
      .orders-section h3 { 
        margin-bottom: 25px; 
        color: var(--pink-main); 
        font-size: 1.5rem;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .order-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
      .order-table th { text-align: left; padding: 12px; border-bottom: 2px solid var(--pink-bg); color: var(--text-muted); font-size: 0.85rem; }
      .order-table td { padding: 15px 12px; border-bottom: 1px solid #eee; font-size: 0.9rem; }
      
      /* Cập nhật các Badge trạng thái mới */
      .status-badge {
        padding: 5px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
      }
      .status-pending { background: #fff4e5; color: #ef6c00; }
      .status-shipping { background: #e3f2fd; color: #1976d2; }
      .status-completed { background: #e8f5e9; color: #2e7d32; }
      .status-cancelled { background: #ffebee; color: #c62828; }

      .btn-home {
        display: inline-block; margin-top: 25px; color: var(--pink-main); 
        text-decoration: none; font-weight: 700; font-size: 0.9rem;
      }

      @media (max-width: 900px) {
        .profile-container { grid-template-columns: 1fr; }
      }

  body
    .profile-container
      aside.profile-card
        .avatar= (user.fullName || user.username || 'U').charAt(0).toUpperCase()
        h2(style="margin-bottom: 5px;")= user.fullName || 'Chưa cập nhật tên'
        span(style="color: var(--pink-main); font-weight: 600; font-size: 0.85rem;") @#{user.username}
        
        .info-list
          .info-item
            span.info-label <i class="fas fa-id-badge"></i> Vai trò
            span.info-value= user.role === 'admin' ? 'Quản trị viên' : 'Khách hàng'
          
          .info-item
            span.info-label <i class="fas fa-phone-alt"></i> Điện thoại
            span.info-value= user.phone || 'Chưa có SĐT'
          
          .info-item
            span.info-label <i class="fas fa-map-marker-alt"></i> Địa chỉ
            span.info-value= user.address || 'Chưa cập nhật địa chỉ'

        a.btn-home(href="/") <i class="fas fa-arrow-left"></i> Quay lại cửa hàng

      main.orders-section
        h3 
          i.fas.fa-shopping-bag
          | Lịch sử mua hàng
        
        if orders && orders.length > 0
          table.order-table
            thead
              tr
                th Mã đơn
                th Ngày mua
                th Tổng tiền
                th Trạng thái
            tbody
              each order in orders
                tr
                  td: b= '#' + order._id.toString().slice(-6).toUpperCase()
                  td= new Date(order.createdAt).toLocaleDateString('vi-VN')
                  td(style="color: var(--pink-main); font-weight: 600;")= order.totalAmount.toLocaleString('vi-VN') + ' đ'
                  td
                    // logic kiểm tra 4 trạng thái đồng bộ với Admin
                    case order.status
                      when 'pending'
                        span.status-badge.status-pending Chờ duyệt
                      when 'shipping'
                        span.status-badge.status-shipping Đang giao
                      when 'cancelled'
                        span.status-badge.status-cancelled Đã hủy
                      when 'completed'
                        span.status-badge.status-completed Hoàn tất
                      default
                        span.status-badge.status-pending Đang xử lý
        else
          div(style="text-align: center; padding: 40px; color: #bbb;")
            i.fas.fa-box-open(style="font-size: 3rem; margin-bottom: 15px; display: block;")
            p Bạn chưa có đơn hàng nào. 
            a(href="/explore" style="color: var(--pink-main); font-weight: 700; text-decoration: none;") Mua sắm ngay!